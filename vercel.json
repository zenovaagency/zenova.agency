{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.zenova.agency"
        }
      ],
      "destination": "https://zenova.agency/:path*",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/about",
      "permanent": true
    }
  ]
}
