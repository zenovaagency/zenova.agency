# Frontend environment variables (Next.js).
# Copy to .env.local and adjust per environment.

# Base URL of the FastAPI backend. Without a trailing slash.
# Local dev:        http://localhost:8000/api/v1
# Production:       https://api.zenova.agency/api/v1
#
# Read by src/lib/api.ts (browser + server) and src/lib/serverContent.ts
# (server only). The NEXT_PUBLIC_ prefix is required because the browser bundle
# reads it too — Next inlines these by textual substitution at build time, so
# the name must appear in full at every use site and can never be destructured.
NEXT_PUBLIC_API_URL=https://api.zenova.agency/api/v1
