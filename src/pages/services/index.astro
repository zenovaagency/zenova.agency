---
/**
 * Services index.
 *
 * The four cards (the same component the home page uses), then the one view
 * the detail pages cannot give: all four side by side on scope, time and
 * support. Every cell in that table comes from SCOPES and SERVICES.meta.
 * No prices: pricing is agreed on a call.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/chrome/Nav.astro';
import Footer from '../../components/chrome/Footer.astro';
import PageHero from '../../components/chrome/PageHero.astro';
import PageNav from '../../components/chrome/PageNav.astro';
import Cta from '../../components/chrome/Cta.astro';
import JsonLd from '../../components/chrome/JsonLd.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { PAGES, SCOPES, SERVICES } from '../../data/site';
import { breadcrumb } from '../../lib/schema';

const page = PAGES.services;

const rows = SERVICES.map((s) => {
  const plans = SCOPES.find((p) => p.slug === s.slug)?.plans ?? [];
  return {
    s,
    entry: plans[0]?.name ?? '',
    entryInfo: plans[0]?.info ?? '',
    build: s.meta[0][0],
    support: s.meta[1],
  };
});
---

<Base title={page.title} description={page.description}>
  <JsonLd slot="head" data={breadcrumb([{ name: 'Services', path: '/services' }])} />

  <Nav />

  <main id="main">
    <PageHero intro={page} />

    <section class="border-t border-line py-[var(--section-y)]" aria-label="The four services">
      <div class="container-z">
        <ul class="grid gap-6 md:grid-cols-2">
          {
            SERVICES.map((s, i) => (
              <li class="flex" data-reveal data-reveal-delay={(i % 2) * 0.08}>
                <ServiceCard service={s} heading="h2" class="w-full" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="border-t border-line bg-white py-[var(--section-y)]" aria-labelledby="compare-title">
      <div class="container-z">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
          <h2 id="compare-title" class="h2 text-ink lg:col-span-7">
            Side by side, <em class="accent-serif">before you call.</em>
          </h2>
          <p class="text-ink-muted lg:col-span-4 lg:col-start-9">
            Where each service usually starts and how long it takes. Price and timeline are
            agreed on a call and fixed in your proposal before any work starts.
          </p>
        </div>

        <div class="mt-12 overflow-x-auto rounded-[var(--radius-lg)] border border-line" data-reveal>
          <table class="compare w-full min-w-[640px] text-left">
            <thead>
              <tr>
                <th scope="col">Service</th>
                <th scope="col">Usually starts with</th>
                <th scope="col">Typical build</th>
                <th scope="col">After launch</th>
                <th scope="col"><span class="sr-only">Details</span></th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr>
                    <th scope="row">
                      <span class="mono mr-3 text-ink-faint tabular-nums">{r.s.n}</span>
                      {r.s.title}
                    </th>
                    <td>
                      <span class="text-ink">{r.entry}</span>
                      <span class="block max-w-[16rem] text-[0.8125rem] text-ink-faint">{r.entryInfo}</span>
                    </td>
                    <td class="text-ink">{r.build}</td>
                    <td>
                      <span class="text-ink">{r.support[0]}</span>
                      <span class="block text-[0.8125rem] text-ink-faint">{r.support[1]}</span>
                    </td>
                    <td class="text-right">
                      <a href={`/services/${r.s.slug}`} class="text-link">
                        <span class="text-link__label">Details<span class="sr-only"> on {r.s.title}</span></span>
                      </a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <div class="border-t border-line py-[var(--section-y)]">
      <PageNav />
    </div>

    <Cta />
  </main>

  <Footer />
</Base>

<style>
  .compare th,
  .compare td {
    padding: 18px 22px;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }
  .compare thead th {
    background: var(--color-paper);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .compare tbody th {
    font-weight: 500;
    color: var(--color-ink);
  }
  .compare tbody tr:last-child > * {
    border-bottom: 0;
  }
  .compare tbody tr {
    transition: background-color 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .compare tbody tr:hover {
    background: #f7faff;
  }
</style>
