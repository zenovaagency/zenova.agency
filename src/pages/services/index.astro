---
/**
 * Services index.
 *
 * An overview, not a document. Each service now has its own page carrying the
 * bullets, the four-up meta grid, the stack, its deliverables and its rate
 * card, so repeating any of that here would just be the detail pages
 * concatenated — and the reader would have no reason to open one.
 *
 * So: four cards, one line of substance each, and a way in.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/chrome/Nav.astro';
import Footer from '../../components/chrome/Footer.astro';
import PageHero from '../../components/chrome/PageHero.astro';
import PageNav from '../../components/chrome/PageNav.astro';
import Cta from '../../components/chrome/Cta.astro';
import JsonLd from '../../components/chrome/JsonLd.astro';
import Motif from '../../components/ui/Motif.astro';
import TextLink from '../../components/ui/TextLink.astro';
import { PAGES, SERVICES } from '../../data/site';
import { breadcrumb } from '../../lib/schema';

const page = PAGES.services;
---

<Base title={page.title} description={page.description}>
  <JsonLd slot="head" data={breadcrumb([{ name: 'Services', path: '/services' }])} />

  <Nav />

  <main id="main">
    <PageHero intro={page} />

    <section class="border-t border-line py-[var(--section-y)]" aria-labelledby="svc-title">
      <div class="container-z">
        <h2 id="svc-title" class="sr-only">The four services</h2>

        <ul class="grid gap-6 md:grid-cols-2">
          {
            SERVICES.map((s) => (
              <li class="flex">
                <article class="card-tint flex w-full flex-col overflow-hidden" data-reveal>
                  {/* Decorative. The stretched link on the heading below
                      already covers this area, so making it a second anchor
                      would only duplicate the destination. */}
                  <div
                    class="svc-art flex aspect-[16/9] items-center justify-center p-8 text-brand"
                    style={`--angle:${s.angle}`}
                    aria-hidden="true"
                  >
                    <Motif kind={s.motif} />
                  </div>

                  <div class="flex flex-1 flex-col border-t border-line/70 p-7 sm:p-8">
                    <div class="mono flex items-center gap-3 text-ink-faint">
                      <span class="tabular-nums">{s.n}</span>
                      <span class="h-px w-8 bg-line-strong" />
                      <span>Service</span>
                    </div>

                    <h3 class="h3 mt-5 text-ink">
                      {/* The whole card is reachable from this one link, so the
                          art above it is aria-hidden rather than a second
                          identical destination in the tab order. */}
                      <a href={`/services/${s.slug}`} class="after:absolute after:inset-0">
                        {s.title}
                      </a>
                    </h3>

                    <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted">{s.short}</p>

                    <div class="mt-auto flex flex-wrap items-end justify-between gap-x-6 gap-y-4 pt-8">
                      <p>
                        <span class="block text-[1.75rem] font-medium leading-none tracking-[-0.02em] text-ink tabular-nums">
                          {s.stat.value}
                        </span>
                        <span class="mono mt-2 block text-ink-faint">{s.stat.label}</span>
                      </p>
                      <TextLink href={`/services/${s.slug}`}>What is included</TextLink>
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="border-t border-line py-[var(--section-y)]">
      <PageNav />
    </div>

    <Cta />
  </main>

  <Footer />
</Base>

<style>
  /* Reuses each service's --angle so the four panels are tinted differently,
     the same way the home cards are, without repeating the saturated fill. */
  .svc-art {
    background: linear-gradient(
      var(--angle),
      rgb(191 224 255 / 0.5) 0%,
      rgb(244 248 255 / 0.9) 55%,
      rgb(255 224 236 / 0.55) 100%
    );
  }
</style>
