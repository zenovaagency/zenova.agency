---
/**
 * Work — the projects index.
 *
 * An editorial showcase: one full-width row per project, a large framed
 * screenshot on one side and the write-up on the other, alternating sides
 * down the page. A service filter sits above the list.
 *
 * These are our own product and design concepts, with no client and no
 * metrics — see the header of data/projects.ts — so the rows carry no proof.
 * Each row says what kind of entry it is in its eyebrow, and the disclosure
 * in the heading band covers the whole list.
 *
 * The filter is progressive: it renders hidden and the script reveals it, so
 * without JS every project is simply listed. Filtering re-alternates the
 * visible rows so the zig-zag never breaks.
 *
 * The counts under the headline are the only numbers on the page, and every
 * one is counted out of PROJECTS rather than claimed.
 *
 * The empty state is still live code and takes over the moment PROJECTS has
 * nothing publishable in it.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/chrome/Nav.astro';
import Footer from '../../components/chrome/Footer.astro';
import PageNav from '../../components/chrome/PageNav.astro';
import Cta from '../../components/chrome/Cta.astro';
import JsonLd from '../../components/chrome/JsonLd.astro';
import Motif from '../../components/ui/Motif.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import TextLink from '../../components/ui/TextLink.astro';
import { Image } from 'astro:assets';
import { PAGES, SERVICES, WORK_COPY } from '../../data/site';
import { published, projectKind, KIND_LABEL, hasSamples } from '../../data/projects';
import { breadcrumb } from '../../lib/schema';

const page = PAGES.work;
const projects = published();
const byService = new Map(SERVICES.map((s) => [s.slug, s]));

// Disappears on its own when the demos and concepts are replaced with real projects.
const hasDemos = hasSamples(projects);

// Only services that actually have a project get a filter button.
const filters = SERVICES.filter((s) => projects.some((p) => p.service === s.slug));

const disciplines = new Set(projects.map((p) => p.service)).size;
const technologies = new Set(projects.flatMap((p) => p.stack)).size;
const pad = (n: number) => String(n).padStart(2, '0');

const counts: [string, string][] = [
  [pad(projects.length), 'Projects'],
  [pad(disciplines), 'Disciplines'],
  [pad(technologies), 'Technologies'],
];
---

<Base title={page.title} description={page.description}>
  <JsonLd slot="head" data={breadcrumb([{ name: 'Work', path: '/work' }])} />

  <Nav />

  <main id="main">
    <!-- Opener. Everything on the wash uses ink-soft (4.8:1), never ink-muted. -->
    <section class="relative overflow-hidden pb-16 pt-36 sm:pt-40">
      <div class="page-wash wash-2 absolute inset-x-0 top-0 -z-10 h-[620px]" aria-hidden="true">
      </div>

      <div class="container-z">
        <div data-reveal>
          <Eyebrow tone="soft">{page.eyebrow}</Eyebrow>
        </div>

        <h1 class="display mt-7 max-w-[16ch] text-ink" data-split data-split-delay="0.1">
          {page.headline}<br /><em class="accent-serif">{page.accent}</em>
        </h1>

        <p
          class="mt-7 max-w-[38rem] text-[1.0625rem] text-ink-soft sm:text-[1.1875rem]"
          data-reveal
          data-reveal-delay="0.35"
        >
          {page.sub}
        </p>

        {
          projects.length > 0 && (
            <ul
              class="mt-14 flex flex-wrap items-baseline gap-x-12 gap-y-7"
              data-reveal
              data-reveal-delay="0.5"
            >
              {counts.map(([value, label]) => (
                <li class="flex items-baseline gap-3">
                  <span class="text-[clamp(1.75rem,6vw,2.25rem)] font-medium leading-none tracking-[-0.03em] tabular-nums text-ink">
                    {value}
                  </span>
                  <span class="mono text-ink-soft">{label}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    {
      projects.length > 0 ? (
        <section class="border-t border-line py-[var(--section-y)]" aria-labelledby="index-title">
          <div class="container-z">
            <div class="grid gap-x-8 gap-y-7 lg:grid-cols-12 lg:items-end">
              <h2 id="index-title" class="h2 text-ink lg:col-span-7" data-split>
                {WORK_COPY.indexTitle}
                <br />
                <em class="accent-serif">{WORK_COPY.indexAccent}</em>
              </h2>

              {/* The disclosure that makes the concepts safe to publish. It
                  covers every row, so it sits above them all. */}
              {hasDemos && (
                <p
                  class="text-[0.9375rem] leading-relaxed text-ink-muted lg:col-span-4 lg:col-start-9"
                  data-reveal
                >
                  {WORK_COPY.demoNote}
                </p>
              )}
            </div>

            {filters.length > 1 && (
              <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-3" data-filter hidden>
                <div class="work-filter" role="group" aria-label="Filter projects by service">
                  <button type="button" class="work-filter__btn" aria-pressed="true" data-filter-value="all">
                    All
                    <span class="work-filter__count tabular-nums" aria-hidden="true">{projects.length}</span>
                  </button>
                  {filters.map((s) => (
                    <button type="button" class="work-filter__btn" aria-pressed="false" data-filter-value={s.slug}>
                      {s.title}
                      <span class="work-filter__count tabular-nums" aria-hidden="true">
                        {projects.filter((p) => p.service === s.slug).length}
                      </span>
                    </button>
                  ))}
                </div>
                <p class="sr-only" aria-live="polite" data-filter-status></p>
              </div>
            )}

            <ol class="work-list mt-14 lg:mt-20" data-work-list>
              {projects.map((p, i) => {
                const service = byService.get(p.service)!;
                // A concept or our own product has no client, so its label
                // stands where the name would.
                const eyebrow = [p.client ?? KIND_LABEL[projectKind(p)], service.title, p.year].join(' · ');
                const href = `/work/${p.slug}`;

                return (
                  <li class="work-row" data-row data-service={p.service} data-flip={String(i % 2 === 1)}>
                    {/* A second way in for the pointer. The title link is the
                        one keyboard and screen-reader target. */}
                    <a href={href} class="work-media" tabindex="-1" aria-hidden="true" data-media>
                      <span class="work-media__inner" data-media-inner>
                        {p.image ? (
                          <Image
                            src={p.image.wide}
                            alt=""
                            widths={[640, 960, 1280, 1600]}
                            sizes="(min-width: 1024px) 56vw, 92vw"
                            loading={i === 0 ? 'eager' : 'lazy'}
                            class="work-media__img"
                          />
                        ) : (
                          <span class="work-media__motif svc-art text-brand" style={`--angle:${p.angle ?? service.angle}`}>
                            <Motif kind={p.motif ?? service.motif} />
                          </span>
                        )}
                      </span>
                      <span class="work-cursor" data-cursor>
                        View project
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                          <path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </a>

                    <div class="work-text" data-reveal>
                      <span class="work-num accent-serif tabular-nums" aria-hidden="true">
                        {pad(i + 1)}
                      </span>
                      <p class="mono mt-4 text-ink-faint">{eyebrow}</p>

                      <h3 class="work-title mt-4 text-ink">
                        <a href={href} class="work-title__link">
                          {p.title}
                          <svg class="work-title__arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M7 17 17 7m0 0H9m8 0v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      </h3>

                      <p class="mt-4 max-w-[34rem] text-[1.0625rem] leading-relaxed text-ink-muted">{p.summary}</p>

                      {p.scope.length > 0 && (
                        <ul class="mt-7 space-y-2.5 border-t border-line pt-6">
                          {p.scope.slice(0, 3).map((item) => (
                            <li class="flex items-start gap-3 text-[0.9375rem] text-ink">
                              <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                              {item}
                            </li>
                          ))}
                        </ul>
                      )}

                      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tools">
                        {p.stack.map((tech) => (
                          <li class="rounded-full border border-line-strong bg-white px-3 py-1.5 text-[0.8125rem] text-ink">
                            {tech}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      ) : (
        <section class="border-t border-line py-[var(--section-y)]" aria-labelledby="empty-title">
          <div class="container-z">
            <div class="max-w-2xl" data-reveal>
              <h2 id="empty-title" class="h1 text-ink">
                {WORK_COPY.emptyTitle}
                <br />
                <em class="accent-serif">{WORK_COPY.emptyAccent}</em>
              </h2>
              <p class="mt-6 text-[1.0625rem] text-ink-muted">{WORK_COPY.emptyBody}</p>

              <div class="mt-9 flex flex-wrap items-center gap-3">
                <Button href={WORK_COPY.emptyPrimaryHref}>{WORK_COPY.emptyPrimary}</Button>
                <Button href={WORK_COPY.emptySecondaryHref} variant="secondary">
                  {WORK_COPY.emptySecondary}
                </Button>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!--
      Shown in both states. With no case studies it is the only substance on
      the page; with them it is still the natural next question, since every
      project belongs to one of these four.
    -->
    <section class="border-t border-line bg-white py-[var(--section-y)]" aria-labelledby="what-title">
      <div class="container-z">
        <h2 id="what-title" class="h2 max-w-xl text-ink" data-split>
          What we build.
        </h2>

        <ul
          class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            SERVICES.map((s) => (
              <li class="relative bg-white p-7" data-reveal>
                <div class="mono flex items-center gap-3 text-ink-faint">
                  <span class="tabular-nums">{s.n}</span>
                  <span class="h-px w-6 bg-line-strong" />
                </div>
                <p class="mt-5 text-[1.1875rem] font-medium tracking-[-0.01em] text-ink">
                  <a href={`/services/${s.slug}`} class="after:absolute after:inset-0">
                    {s.title}
                  </a>
                </p>
                <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-muted">{s.short}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-10" data-reveal>
          <TextLink href="/services">Every service in detail</TextLink>
        </div>
      </div>
    </section>

    <div class="border-t border-line py-[var(--section-y)]">
      <PageNav />
    </div>

    <Cta />
  </main>

  <Footer />
</Base>

<style>
  /* Copied from PageHero's wash-2, unchanged: Astro scopes component CSS, so
     the class cannot be imported. Brand collects low and right, well under
     the headline. */
  .page-wash::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-paper) 0%, rgb(246 249 255 / 0) 46%);
  }

  .wash-2 {
    background:
      radial-gradient(40% 46% at 90% 92%, rgb(0 107 255 / 0.5), transparent 66%),
      radial-gradient(42% 52% at 68% 30%, rgb(111 182 255 / 0.45), transparent 72%),
      radial-gradient(30% 40% at 99% 20%, rgb(255 174 203 / 0.45), transparent 70%),
      linear-gradient(180deg, #f0f6ff 0%, rgb(246 249 255 / 0) 100%);
  }

  .svc-art {
    background: linear-gradient(
      var(--angle),
      rgb(191 224 255 / 0.5) 0%,
      rgb(244 248 255 / 0.9) 55%,
      rgb(255 224 236 / 0.55) 100%
    );
  }

  /* --- Filter ------------------------------------------------------- */
  .work-filter {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 5px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #ffffff;
  }

  .work-filter__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      background-color 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .work-filter__btn:hover {
    color: var(--color-ink);
    background: rgb(11 53 88 / 0.05);
  }

  .work-filter__btn[aria-pressed='true'] {
    color: #ffffff;
    background: var(--color-ink);
  }

  .work-filter__btn:focus-visible {
    outline: 2px solid var(--color-brand-text);
    outline-offset: 2px;
  }

  .work-filter__count {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgb(11 53 88 / 0.07);
    font-size: 0.75rem;
  }

  .work-filter__btn[aria-pressed='true'] .work-filter__count {
    background: rgb(255 255 255 / 0.18);
  }

  /* --- Rows --------------------------------------------------------- */
  .work-list {
    display: grid;
    gap: clamp(4.5rem, 10vw, 9rem);
  }

  .work-row {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .work-row[hidden] {
    display: none;
  }

  .work-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background: #e4e9f6;
    box-shadow:
      0 1px 2px rgb(11 53 88 / 0.08),
      0 40px 80px -40px rgb(11 53 88 / 0.35);
  }

  /* Taller than the frame so the scroll drift never shows an edge. */
  .work-media__inner {
    position: absolute;
    inset: -6% 0;
    display: block;
  }

  .work-media__img,
  .work-media__motif {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .work-media__motif {
    display: grid;
    place-items: center;
    padding: 12%;
  }

  /* The "View project" pill follows the pointer over the picture. Fine
     pointers only; everywhere else the title link is the cue. */
  .work-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: none;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--color-brand-text);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--cx, 50%), var(--cy, 50%), 0) translate(-50%, -50%) scale(0.6);
    transition:
      opacity 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 12px 30px -10px rgb(0 60 160 / 0.55);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-media {
      cursor: none;
    }
    .work-cursor {
      display: inline-flex;
    }
    .work-media:hover .work-cursor {
      opacity: 1;
      transform: translate3d(var(--cx, 50%), var(--cy, 50%), 0) translate(-50%, -50%) scale(1);
    }
    .work-row:has(.work-media:hover) .work-media__img,
    .work-row:has(.work-title__link:hover) .work-media__img {
      transform: scale(1.03);
    }
    .work-row:has(.work-media:hover) .work-title__link,
    .work-title__link:hover {
      color: var(--color-brand-text);
    }
    .work-row:has(.work-media:hover) .work-title__arrow,
    .work-title__link:hover .work-title__arrow {
      transform: translate(3px, -3px);
      opacity: 1;
    }
  }

  .work-num {
    display: block;
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 0.8;
    color: rgb(11 53 88 / 0.16);
  }

  .work-title {
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .work-title__link {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.25em;
    transition: color 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .work-title__link:focus-visible {
    outline: 2px solid var(--color-brand-text);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .work-title__arrow {
    flex-shrink: 0;
    margin-top: 0.12em;
    width: 0.6em;
    height: 0.6em;
    opacity: 0.45;
    transition:
      transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* --- 1024+: the alternating showcase ------------------------------ */
  @media (min-width: 1024px) {
    .work-row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 3rem;
    }

    .work-media {
      grid-row: 1;
      grid-column: 1 / span 7;
    }

    .work-text {
      grid-row: 1;
      grid-column: 8 / span 5;
    }

    .work-row[data-flip='true'] .work-media {
      grid-column: 6 / span 7;
    }

    .work-row[data-flip='true'] .work-text {
      grid-column: 1 / span 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-media__img,
    .work-cursor,
    .work-title__arrow {
      transition: none;
    }
  }
</style>

<script>
  import { motion } from '../../lib/scroll';
  import { DESKTOP, DUR, EASE } from '../../lib/motion';

  const list = document.querySelector<HTMLElement>('[data-work-list]');
  const rows = list ? Array.from(list.querySelectorAll<HTMLElement>('[data-row]')) : [];

  // --- Filter ---------------------------------------------------------
  const bar = document.querySelector<HTMLElement>('[data-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  let refresh: () => void = () => {};

  if (bar && rows.length) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));

    const apply = (value: string) => {
      let shown = 0;
      rows.forEach((row) => {
        const match = value === 'all' || row.dataset.service === value;
        row.hidden = !match;
        // Re-alternate the visible rows so the zig-zag survives filtering.
        if (match) row.dataset.flip = String(shown++ % 2 === 1);
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterValue === value)));
      if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}`;
      refresh();
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filterValue ?? 'all')));
  }

  // --- Cursor pill ----------------------------------------------------
  // Written straight to CSS vars, rAF-batched, fine pointers only.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-media]').forEach((media) => {
      let frame = 0;
      media.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = media.getBoundingClientRect();
          media.style.setProperty('--cx', `${e.clientX - r.left}px`);
          media.style.setProperty('--cy', `${e.clientY - r.top}px`);
        });
      });
    });
  }

  // --- Scroll motion --------------------------------------------------
  motion().then(({ gsap, ScrollTrigger, reduced }) => {
    refresh = () => ScrollTrigger.refresh();
    // Reduced motion keeps the static list, which is also what a reader
    // with JS disabled gets.
    if (reduced || !rows.length) return;

    const frames = rows.map((r) => r.querySelector<HTMLElement>('[data-media]')!).filter(Boolean);

    // Each picture unmasks upward. The start state is set here, not in CSS,
    // so a failed script can never leave the list hidden.
    const clip = (el: HTMLElement, top: string) =>
      `inset(${top} 0% 0% 0% round ${getComputedStyle(el).borderTopLeftRadius})`;

    frames.forEach((el) => gsap.set(el, { clipPath: clip(el, '100%'), y: 56 }));

    ScrollTrigger.batch(frames, {
      start: 'top 88%',
      once: true,
      onEnter: (batch) => {
        gsap.to(batch, {
          clipPath: (_: number, el: HTMLElement) => clip(el, '0%'),
          y: 0,
          duration: DUR.hero * 1.2,
          ease: EASE,
          stagger: 0.1,
          clearProps: 'clipPath,transform',
        });
      },
    });

    // Desktop only: the picture drifts against the scroll inside its frame.
    gsap.matchMedia().add(DESKTOP, () => {
      rows.forEach((row) => {
        const inner = row.querySelector<HTMLElement>('[data-media-inner]');
        if (!inner) return;
        gsap.fromTo(
          inner,
          { yPercent: 4 },
          {
            yPercent: -4,
            ease: 'none',
            scrollTrigger: { trigger: row, start: 'top bottom', end: 'bottom top', scrub: true },
          },
        );
      });
    });
  });
</script>
