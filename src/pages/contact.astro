---
/**
 * Contact.
 *
 * Left: what happens after you get in touch, and the terms that matter
 * before you do (how pricing is agreed, ownership, response time). Right: the panel
 * with the two ways in — a written brief, or a 30-minute call (a link out to
 * our Calendly page).
 *
 * The brief is POSTed to /api/contact (api/contact.ts, a Vercel Function that
 * emails it to us through Resend). See islands/ContactForm.tsx.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import ContactForm from '../islands/ContactForm';
import Button from '../components/ui/Button.astro';
import { SITE, SERVICES, SCOPES } from '../data/site';
import '../styles/contact.css';

const services = SERVICES.map((s) => ({ slug: s.slug, title: s.title }));

// Scope option id → readable label, for briefs that arrive from a scope card.
const plans = Object.fromEntries(
  SCOPES.flatMap((svc) => svc.plans.map((p) => [p.id, `${p.name} (${svc.label})`])),
);

const next = [
  {
    title: 'We reply within one working day',
    body: 'With a few questions, or a time to talk if the brief already covers it.',
  },
  {
    title: 'A 30-minute call',
    body: 'Your goals, your users, what exists already, and what a first phase could look like.',
  },
  {
    title: 'A written, fixed-price proposal',
    body: 'Scope, phases, a price for each and a timeline. Nothing starts until you approve it.',
  },
];

const terms = [
  ['Fixed price per phase', 'No hourly billing.'],
  ['Yours from day one', 'Code, designs, domain and accounts.'],
  ['30–90 days of support', 'Included after launch, by scope.'],
];
---

<Base
  title="Contact — Start a project | Zenova"
  description="Send a project brief or book a 30-minute call. We reply within one working day with questions or a time to talk."
>
  <Nav />

  <main id="main">
    <section class="relative overflow-hidden pb-[var(--section-y)] pt-32 sm:pt-36">
      <div class="contact-wash absolute inset-x-0 top-0 -z-10 h-[620px]" aria-hidden="true"></div>

      <div class="container-z">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5 lg:pt-6">
            <p class="mono flex items-center gap-2.5 text-ink-soft" data-reveal>
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
              Start a project
            </p>
            <h1 class="h1 mt-6 text-ink" data-split>
              Tell us what<br />you&rsquo;re <em class="accent-serif">building.</em>
            </h1>
            <p class="mt-6 max-w-md text-[1.0625rem] text-ink-soft" data-reveal>
              Send a short brief or book a call — whichever is easier. Either way, you talk to the
              people who would build it.
            </p>

            <ol class="next mt-12" data-reveal>
              {
                next.map((s, i) => (
                  <li class="next__step">
                    <span class="next__n tabular-nums" aria-hidden="true">
                      {i + 1}
                    </span>
                    <div>
                      <p class="font-medium text-ink">{s.title}</p>
                      <p class="mt-1 text-[0.9375rem] text-ink-muted">{s.body}</p>
                    </div>
                  </li>
                ))
              }
            </ol>

            <dl class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-line bg-line sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3" data-reveal>
              {
                terms.map(([t, d]) => (
                  <div class="bg-white p-5">
                    <dt class="text-[0.9375rem] font-medium text-ink">{t}</dt>
                    <dd class="mt-1 text-[0.8125rem] text-ink-muted">{d}</dd>
                  </div>
                ))
              }
            </dl>

            <p class="mt-10 text-[0.9375rem] text-ink-muted" data-reveal>
              Prefer plain email?
              <a
                href={`mailto:${SITE.email}`}
                class="ml-1 text-brand-text underline decoration-sky decoration-1 underline-offset-4 transition-colors hover:decoration-brand"
              >
                {SITE.email}
              </a>
            </p>
          </div>

          <!-- No data-reveal here: a transform on an ancestor would become the
               containing block for anything fixed inside the panel. -->
          <div class="lg:col-span-7">
            <div class="cp">
              <div class="cp-panel">
                <div class="cp-call">
                  <p class="text-[0.9375rem] text-ink-muted">
                    Prefer to talk it through? Pick a time for a 30-minute video call. No pitch
                    deck, no obligation.
                  </p>
                  <Button href={SITE.calendlyUrl} variant="secondary" external>Book a 30-min call</Button>
                </div>
                <ContactForm
                  client:load
                  to={SITE.email}
                  endpoint={SITE.contactEndpoint}
                  services={services}
                  plans={plans}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .contact-wash {
    background:
      radial-gradient(48% 70% at 82% 0%, #bfe0ff 0%, rgb(191 224 255 / 0) 66%),
      radial-gradient(34% 56% at 98% 40%, #ffe0ec 0%, rgb(255 224 236 / 0) 70%),
      linear-gradient(180deg, #eef4ff 0%, rgb(246 249 255 / 0) 100%);
  }

  .next {
    position: relative;
    display: grid;
    gap: 26px;
  }
  .next::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: linear-gradient(var(--color-brand), var(--color-line-strong));
  }
  .next__step {
    position: relative;
    display: flex;
    gap: 18px;
  }
  .next__n {
    position: relative;
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    flex-shrink: 0;
    border: 1px solid var(--color-brand);
    border-radius: 999px;
    background: #ffffff;
    color: var(--color-brand-text);
    font-size: 0.8125rem;
    font-weight: 500;
  }
</style>
