---
/**
 * Careers.
 *
 * JOBS is empty by design (every entry is `draft: true`), so this renders the
 * "no open roles" state and points at SITE.careersEmail — which until now was
 * exported and never used anywhere on the site.
 *
 * The perks and the hiring steps show in both states. They are the part a
 * candidate is actually assessing, and they do not depend on a role being
 * open.
 *
 * Because the empty state IS the page for now, it is built as a panel rather
 * than as a paragraph — the same reasoning /work applies to its own empty
 * state. It used to set its heading at .h1, which is the size PageHero already
 * uses directly above it, so the two stacked at identical scale and the page
 * had no hierarchy at all.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/chrome/Nav.astro';
import Footer from '../../components/chrome/Footer.astro';
import PageHero from '../../components/chrome/PageHero.astro';
import PageNav from '../../components/chrome/PageNav.astro';
import Cta from '../../components/chrome/Cta.astro';
import JsonLd from '../../components/chrome/JsonLd.astro';
import Button from '../../components/ui/Button.astro';
import TextLink from '../../components/ui/TextLink.astro';
import { CAREERS, PAGES, SITE } from '../../data/site';
import { openRoles } from '../../data/jobs';
import { breadcrumb } from '../../lib/schema';

const page = PAGES.careers;
const roles = openRoles();
const mailto = `mailto:${SITE.careersEmail}`;
---

<Base title={page.title} description={page.description}>
  <JsonLd slot="head" data={breadcrumb([{ name: 'Careers', path: '/careers' }])} />

  <Nav />

  <main id="main">
    <PageHero intro={page} />

    <section
      class="border-t border-line py-[var(--section-y)]"
      aria-labelledby={roles.length > 0 ? 'roles-title' : 'no-roles-title'}
    >
      <div class="container-z">
        {
          roles.length > 0 ? (
            <>
              <h2 id="roles-title" class="h2 text-ink" data-split>
                {CAREERS.openTitle}
              </h2>

              <ul class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line">
                {roles.map((job) => (
                  <li class="relative bg-white p-7" data-reveal>
                    <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
                      <div class="max-w-xl">
                        <p class="mono text-ink-faint">
                          {job.team} · {job.type} · {job.location}
                        </p>
                        <h3 class="h3 mt-4 text-ink">
                          <a href={`/careers/${job.slug}`} class="after:absolute after:inset-0">
                            {job.title}
                          </a>
                        </h3>
                        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted">
                          {job.summary}
                        </p>
                      </div>
                      <span class="mono shrink-0 text-brand-text" aria-hidden="true">
                        View role &rarr;
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <div class="card-tint p-8 sm:p-12 lg:p-16" data-reveal>
              <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
                <div class="lg:col-span-7">
                  <h2 id="no-roles-title" class="h2 text-ink" data-split>
                    {CAREERS.emptyTitle}
                    <br />
                    <em class="accent-serif">{CAREERS.emptyAccent}</em>
                  </h2>
                  <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-ink-muted">
                    {CAREERS.emptyBody}
                  </p>

                  <div class="mt-9 flex flex-wrap items-center gap-3">
                    <Button href={mailto}>{CAREERS.applyCta}</Button>
                    <Button href="/about" variant="ghost">
                      {CAREERS.aboutCta}
                    </Button>
                  </div>
                </div>

                <div class="lg:col-span-4 lg:col-start-9">
                  <p class="mono text-ink-faint">What to send</p>
                  <p class="mt-5 text-[0.9375rem] leading-relaxed text-ink-muted">
                    {CAREERS.emptyAside}
                  </p>
                  <div class="mt-7 border-t border-line pt-6">
                    <TextLink href={mailto}>{SITE.careersEmail}</TextLink>
                  </div>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section
      class="border-t border-line bg-white py-[var(--section-y)]"
      aria-labelledby="perks-title"
    >
      <div class="container-z">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <h2 id="perks-title" class="h2 text-ink" data-split>
              {CAREERS.perksTitle}
            </h2>
            <p class="mt-5 text-ink-muted" data-reveal>{CAREERS.lede}</p>
          </div>

          <ul class="grid gap-6 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
            {
              CAREERS.perks.map((perk) => (
                <li class="card-tint p-7" data-reveal>
                  <p class="text-[1.1875rem] font-medium tracking-[-0.01em] text-ink">
                    {perk.title}
                  </p>
                  <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-muted">{perk.blurb}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-[var(--section-y)]" aria-labelledby="hiring-title">
      <div class="container-z">
        <h2 id="hiring-title" class="h2 max-w-xl text-ink" data-split>
          {CAREERS.hiringTitle}
        </h2>

        <ol
          class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            CAREERS.hiring.map((s) => (
              <li class="step relative bg-white p-7" data-reveal>
                <span class="step-mark mono tabular-nums">{s.n}</span>
                <p class="mt-6 text-[1.1875rem] font-medium tracking-[-0.01em] text-ink">
                  {s.title}
                </p>
                <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-muted">{s.blurb}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-10" data-reveal>
          <TextLink href={mailto}>{CAREERS.applyCta}</TextLink>
        </div>
      </div>
    </section>

    <div class="border-t border-line py-[var(--section-y)]">
      <PageNav />
    </div>

    <Cta />
  </main>

  <Footer />
</Base>

<style>
  /*
    The hiring steps are the one genuine sequence on this site, so they get a
    rail rather than four adjacent boxes. Home already owns the scrubbed
    progress line (home/Process), the sticky stack and the pinned rail, so this
    is deliberately none of those: it is static CSS, and /careers continues to
    ship no client JS of its own.

    The line is drawn per cell across the full width and the badge sits on top
    of it, opaque. That is what makes it continue across the 1px grid gaps —
    a connector drawn only from badge to cell edge leaves the next cell's
    padding as a visible break in the line.
  */
  .step-mark {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--color-sky-soft);
    background: var(--color-surface);
    color: var(--color-brand-text);
  }

  /* Only at lg, where the grid is genuinely one row of four. At sm it is a
     2x2 and a rail running off the end of the first row into the start of the
     second would describe an order the layout does not have. */
  @media (min-width: 1024px) {
    .step::before {
      content: '';
      position: absolute;
      /* p-7 (28px) + half the 34px badge. */
      top: 45px;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, var(--color-sky), var(--color-line-strong));
    }

    /* Stop the rail at the first and last badge centres, so it reads as
       spanning the sequence rather than running off both ends of it. */
    .step:first-child::before {
      left: 45px;
    }

    .step:last-child::before {
      right: calc(100% - 45px);
    }
  }
</style>
