---
/**
 * One service, as a card. Used by the home bento and the /services index, so
 * the two can never drift apart.
 *
 *   wide   a letterboxed 16:10 visual, for the long cells of the bento
 *   tall   the visual at its native 4:3

 * Both stack the visual above the text, so cards in one row line up and
 * every visual is shown whole; the drawings bleed their own background into
 * the letterbox (see ServiceVisual), so a wider frame never shows bands.
 *
 * The whole card is one link (a stretched anchor on the title), labelled with
 * where it goes rather than "Learn more". The timeline comes from
 * SERVICES.meta — never typed in here. No prices: those are agreed on a call.
 *
 * Hover: the border warms to brand blue and the arrow chip fills. The card
 * itself never lifts and its visual never zooms.
 */
import ServiceVisual from './ui/ServiceVisual.astro';
import type { Service } from '../data/site';

interface Props {
  service: Service;
  layout?: 'wide' | 'tall';
  /** h2 on pages where the cards are the main content, h3 inside a section. */
  heading?: 'h2' | 'h3';
  class?: string;
}

const { service: s, layout = 'tall', heading = 'h3', class: className = '' } = Astro.props;
const Heading = heading;
---

<article
  class:list={['svc-card group', layout === 'wide' ? 'svc-card--wide' : 'svc-card--tall', className]}
>
  <div class="svc-card__art" aria-hidden="true">
    <ServiceVisual kind={s.slug} decorative />
  </div>

  <div class="svc-card__body">
    <p class="mono flex items-center gap-3 text-ink-faint">
      <span class="tabular-nums">{s.n}</span>
      <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
      <span>{s.meta[1][0]} {s.meta[1][1].toLowerCase()}</span>
    </p>

    <Heading class="mt-4 text-[1.75rem] font-medium leading-[1.08] tracking-[-0.025em] text-ink sm:text-[2rem]">
      <a href={`/services/${s.slug}`} class="svc-card__link">
        {s.title}
        <span class="sr-only"> — scope and process</span>
      </a>
    </Heading>

    <p class="mt-3 max-w-md text-[0.9875rem] leading-relaxed text-ink-muted">{s.short}</p>

    <ul class="mt-5 flex flex-wrap gap-2">
      {
        s.bullets.slice(0, 3).map((b) => (
          <li class="rounded-full border border-line bg-paper px-3 py-1.5 text-[0.8125rem] text-ink">{b}</li>
        ))
      }
    </ul>

    <div class="mt-auto flex items-end justify-between gap-4 pt-8">
      <p>
        <span class="block text-[1.375rem] font-medium leading-none tracking-[-0.02em] text-ink tabular-nums">
          {s.meta[0][0]}
        </span>
        <span class="mono mt-2 block text-ink-faint">{s.meta[0][1]}</span>
      </p>
      <span class="svc-card__go" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</article>

<style>
  .svc-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
    transition: border-color 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .svc-card__art {
    margin: 10px 10px 0;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 8px);
    aspect-ratio: 4 / 3;
  }

  .svc-card__art :global(.viz) {
    height: 100%;
  }

  .svc-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px 28px 28px;
  }

  @media (min-width: 1024px) {
    .svc-card--wide .svc-card__art {
      aspect-ratio: 16 / 10;
    }
  }

  .svc-card__art :global(.viz) {
    width: 100%;
  }

  /* The title link covers the whole card. */
  .svc-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .svc-card__link:focus-visible {
    outline: none;
  }
  .svc-card:focus-within {
    outline: 2px solid var(--color-brand-text);
    outline-offset: 3px;
  }

  .svc-card__go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    transition:
      background-color 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) {
    .svc-card:hover {
      border-color: rgb(0 96 230 / 0.4);
    }
    .svc-card:hover .svc-card__go {
      background: var(--color-brand-text);
      border-color: var(--color-brand-text);
      color: #ffffff;
    }
  }
</style>

