---
import Eyebrow from '../ui/Eyebrow.astro';
import Artifact from '../ui/Artifact.astro';
import TextLink from '../ui/TextLink.astro';
import { DELIVERABLES } from '../../data/site';
---

<section id="deliverables" class="relative overflow-hidden bg-white py-[var(--section-y)]">
  <div class="container-z">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow>What you get</Eyebrow>
        <h2 class="h1 mt-6 text-ink" data-split>
          Not a deck.<br /><em class="accent-serif">Working things.</em>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal>
        <p class="text-ink-muted">
          Every engagement ends with artifacts you own and can run without us.
          This is the actual list.
        </p>
        <TextLink href="/services" class="mt-5">See what each service ships</TextLink>
      </div>
    </div>
  </div>

  <!--
    Horizontal rail. On desktop this pins and scrubs sideways; below lg it is
    a native snap-scroll carousel, because pinning on touch fights the
    platform and traps the reader.
  -->
  <div id="work-rail" class="mt-14 lg:mt-20 lg:flex lg:h-[74svh] lg:items-center">
    <div id="work-viewport" class="lg:w-full lg:overflow-hidden">
      <ul
        id="work-track"
        class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 [scrollbar-width:none] lg:snap-none lg:overflow-visible lg:pb-0"
        style="padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)))"
      >
        {
          DELIVERABLES.map((d, i) => (
            <li class="w-[78vw] shrink-0 snap-start sm:w-[22rem] lg:w-[24rem]">
              <article class="card-tint flex h-full flex-col overflow-hidden">
                <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#f4f8ff] to-[#eaf2ff] p-7">
                  <Artifact art={d.art} />
                </div>
                <div class="flex flex-1 flex-col border-t border-line/70 p-6">
                  <div class="mono flex items-center gap-3 text-ink-faint">
                    <span class="tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                    <span class="h-px w-6 bg-line-strong" />
                    <span>{d.label}</span>
                  </div>
                  <h3 class="mt-4 text-[1.375rem] font-medium tracking-[-0.015em] text-ink">
                    {d.title}
                  </h3>
                  <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">{d.blurb}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  #work-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { motion } from '../../lib/scroll';
  import { DESKTOP } from '../../lib/motion';

  motion().then(({ gsap, reduced }) => {
    if (reduced) return; // native horizontal scrolling still works

    // gsap.matchMedia scopes every tween and trigger created inside it, and
    // reverts them automatically when the query stops matching.
    gsap.matchMedia().add(DESKTOP, () => {
        const rail = document.getElementById('work-rail');
        const track = document.getElementById('work-track');
        if (!rail || !track) return;

        // Measured in a function so `invalidateOnRefresh` recomputes it on
        // resize rather than pinning to a stale width.
        const distance = () => Math.max(track.scrollWidth - window.innerWidth, 0);

        gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: rail,
            start: 'top 88px',
            end: () => `+=${distance()}`,
            pin: true,
            scrub: 0.6,
            invalidateOnRefresh: true,
            anticipatePin: 1,
          },
        });
    });
  });
</script>
