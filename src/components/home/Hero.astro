---
import Button from '../ui/Button.astro';
import { HERO, SERVICES } from '../../data/site';

/**
 * The hero: centered type over a liquid glass shader (lib/liquid-shader.ts).
 *
 * Three layers, back to front:
 *   1. a static CSS gradient — what no-JS, no-WebGL and the first frame see
 *   2. the shader canvas, faded in once its first frame has drawn
 *   3. the type, whose letters react to the cursor (lib/proximity-text.ts)
 *
 * The cursor bends the shader like a lens and thickens the letters nearest to
 * it, so moving across the headline does both at once. Neither runs on touch
 * or under reduced motion, where the hero is still and complete.
 */
---

<section
  class="hero relative isolate flex min-h-[100svh] flex-col items-center justify-center overflow-hidden pb-20 pt-32 text-center"
  data-hero
>
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true">
    <canvas class="hero-canvas absolute inset-0 h-full w-full" data-liquid></canvas>
  </div>

  <div class="container-z relative">
    <div class="mx-auto flex max-w-[60rem] flex-col items-center">
      <p class="mono flex items-center gap-2.5 text-ink-soft" data-reveal>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
        {HERO.eyebrow}
      </p>

      <h1 class="display hero-title mt-7 text-ink" data-proximity>
        {HERO.headline}<br />
        <em class="accent-serif">{HERO.headlineAccent}</em>
      </h1>

      <p
        class="mt-7 max-w-[40rem] text-[1.0625rem] text-ink-soft sm:text-[1.1875rem]"
        data-reveal
        data-reveal-delay="0.45"
      >
        {HERO.sub}
      </p>

      <div class="hero-ctas mt-10 flex flex-wrap items-center justify-center gap-3" data-reveal data-reveal-delay="0.6">
        <Button href={HERO.primaryHref} size="lg" arrow="split">{HERO.primaryCta}</Button>
        <Button href={HERO.secondaryHref} variant="secondary" size="lg">{HERO.secondaryCta}</Button>
      </div>

      <nav class="mt-14 w-full" aria-label="Services" data-reveal data-reveal-delay="0.75">
        <ul class="hero-chips">
          {
            SERVICES.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="hero-chip">
                  <span class="hero-chip__n mono tabular-nums text-ink-faint">{s.n}</span>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 lg:block" data-reveal data-reveal-delay="0.9">
    <div class="mono flex flex-col items-center gap-3 text-ink-soft">
      <span class="scroll-cue h-8 w-px bg-gradient-to-b from-transparent via-brand to-transparent"></span>
    </div>
  </div>
</section>

<style>
  /* Static fallback, and the frame before the shader's first draw. Same
     palette as the shader, so the handover is a soft fade, not a jump. */
  .hero-bg {
    background:
      radial-gradient(60% 50% at 50% 0%, #bfe0ff 0%, transparent 70%),
      radial-gradient(40% 50% at 0% 30%, #dcebff 0%, transparent 70%),
      radial-gradient(40% 50% at 100% 25%, #9ccaff 0%, transparent 70%),
      radial-gradient(30% 30% at 100% 0%, #ffe0ec 0%, transparent 70%),
      #f6f9ff;
  }

  .hero-canvas {
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-canvas[data-ready] {
    opacity: 1;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6.4vw, 5.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  /* --- Proximity text (lib/proximity-text.ts) ---------------------- */
  .hero-title :global(.pt-word) {
    display: inline-block;
    white-space: nowrap;
  }
  .hero-title :global(.pt-char) {
    --k: 0;
    display: inline-block;
    -webkit-text-stroke: calc(var(--k) * 1.4px) currentColor;
    transform: translateY(calc(var(--k) * -4px));
    transition:
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      -webkit-text-stroke-width 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-title :global(.pt-char[data-serif]) {
    -webkit-text-stroke: 0;
    color: color-mix(in srgb, var(--color-brand-text) calc(var(--k) * 100%), var(--color-ink));
  }

  /* Held back until the letters are split, so the entrance does not flash
     the plain headline first. If the script never runs, a delayed fallback
     shows it anyway — the headline can never stay hidden. */
  :global(html.js) .hero-title:not([data-pt-ready]) {
    opacity: 0;
    animation: pt-fallback 0s linear 2.5s forwards;
  }
  @keyframes pt-fallback {
    to {
      opacity: 1;
    }
  }

  /* Entrance: each word arrives out of a soft blur, left to right. */
  .hero-title:global(.pt-enter) :global(.pt-word) {
    animation: pt-in 1000ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }
  @keyframes pt-in {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--color-ink);
    font-size: 0.875rem;
    transition:
      background-color 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (hover: hover) {
    .hero-chip:hover {
      background: #ffffff;
      border-color: rgb(0 96 230 / 0.35);
    }
  }

  /* Phones: an even 2×2 grid, every chip the same size. From 640px up they
     sit in one centred, wrapping row at their natural widths. */
  .hero-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
  }
  .hero-chips .hero-chip {
    width: 100%;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 10px;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  @media (max-width: 379px) {
    .hero-chip__n {
      display: none;
    }
  }
  @media (min-width: 640px) {
    .hero-chips {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      max-width: none;
    }
    .hero-chips .hero-chip {
      width: auto;
      gap: 10px;
      padding: 0 16px;
      font-size: 0.875rem;
    }
  }

  /* Under 480px the two CTAs stack full width, so neither wraps mid-label. */
  @media (max-width: 479px) {
    .hero-ctas > :global(.btn) {
      width: 100%;
    }
  }

  .scroll-cue {
    animation: cue 2.6s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0%, 100% { transform: scaleY(0.4); opacity: 0.5; }
    50%      { transform: scaleY(1);   opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue { animation: none; }
  }
</style>

<script>
  import { mountLiquid } from '../../lib/liquid-shader';
  import { mountProximityText } from '../../lib/proximity-text';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-liquid]');
  const title = hero?.querySelector<HTMLElement>('[data-proximity]');

  if (hero && canvas) mountLiquid(canvas, hero);

  if (hero && title) {
    // Split after the webfont lands, so letter positions are measured on the
    // real glyphs rather than the fallback face.
    (document.fonts?.ready ?? Promise.resolve()).then(() => mountProximityText(title, hero));
  }
</script>
