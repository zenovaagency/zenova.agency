---
import AvailabilityPill from '../ui/AvailabilityPill.astro';
import Button from '../ui/Button.astro';
import HeroGradient from '../../islands/HeroGradient';
import { HERO } from '../../data/site';
---

<!--
  Centered hero on an animated blue field: GradFlow (React island) renders
  an `animated`-type WebGL gradient over the static CSS gradient that ships
  in the HTML. No-JS visitors and the pre-hydration frame see the static
  version; reduced-motion users get GradFlow's own static frame.
-->
<section
  class="relative isolate flex min-h-[100svh] flex-col items-center justify-center overflow-hidden pb-24 pt-32 text-center"
>
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true">
    <HeroGradient client:load />
  </div>

  <div class="container-z relative">
    <div class="mx-auto flex max-w-[54rem] flex-col items-center">
      <div data-reveal>
        <AvailabilityPill label={HERO.badge} />
      </div>

      <h1 class="display mt-7 text-ink" data-split data-split-delay="0.15">
        {HERO.headline}{' '}
        <em class="accent-serif">{HERO.headlineAccent}</em>
      </h1>

      <p
        class="mt-6 max-w-[36rem] text-[1.0625rem] text-ink-soft sm:text-[1.1875rem]"
        data-reveal
        data-reveal-delay="0.5"
      >
        {HERO.sub}
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal data-reveal-delay="0.62">
        <Button href={HERO.primaryHref}>{HERO.primaryCta}</Button>
        <Button href={HERO.secondaryHref} variant="ghost">{HERO.secondaryCta}</Button>
      </div>
    </div>
  </div>

  <div class="container-z relative mt-16 hidden lg:block" data-reveal data-reveal-delay="0.8">
    <div class="mono flex items-center justify-center gap-3 text-ink-soft">
      <span class="scroll-cue h-8 w-px bg-gradient-to-b from-transparent via-brand to-transparent"
      ></span>
      Scroll
    </div>
  </div>
</section>

<style>
  /*
    Static fallback for the hero background, verbatim from the reference
    spec: one saturated blue glow centred on the top edge, pale washes at
    the upper corners, white beneath. It ships in the HTML and stays
    visible until GradFlow's first opaque frame covers it; the palette
    matches the island's colors so the handover is seamless. The text sits
    on the light middle of the field, so ink type carries the contrast —
    no veil layer needed.
  */
  .hero-bg {
    background:
      radial-gradient(circle at 50% 0%,
        #5E91F9 0%,
        #B8D2FA 25%,
        transparent 55%
      ),
      radial-gradient(circle at 0% 25%,
        #C8DDF8 0%,
        #DCF3FE 35%,
        transparent 65%
      ),
      radial-gradient(circle at 100% 25%,
        #6E97F9 0%,
        #C6DDF9 35%,
        transparent 65%
      ),
      #FFFFFF;
  }

  .scroll-cue {
    animation: cue 2.6s var(--ease-out-expo) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0%, 100% { transform: scaleY(0.4); opacity: 0.5; }
    50%      { transform: scaleY(1);   opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue { animation: none; }
  }
</style>
