---
import Eyebrow from '../ui/Eyebrow.astro';
import TextLink from '../ui/TextLink.astro';
import { SERVICES } from '../../data/site';
import { Image } from 'astro:assets';
import { published, projectKind, type Project } from '../../data/projects';

/**
 * Selected work, split into the three things it can be:
 *
 *   Client work      — real engagements, named with permission. None are
 *                      published yet, and the section says so rather than
 *                      hiding the shelf.
 *   Our products     — a one-line pointer to the product band above, not a
 *                      second copy of the pitch.
 *   Design concepts  — our own design exercises, each with a visible
 *                      "Concept" badge on the tile itself.
 *
 * When a client project is published (see data/projects.ts), it lands on the
 * first shelf by itself, because projectKind() derives the shelf from the data.
 */
const projects = published();
const byService = new Map(SERVICES.map((s) => [s.slug, s]));
const of = (kind: ReturnType<typeof projectKind>): Project[] =>
  projects.filter((p) => projectKind(p) === kind);

const clients = of('client');
const products = of('product');
const concepts = of('concept');
---

<section id="work" class="section-y relative" aria-labelledby="work-title">
  <div class="container-z">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow>Selected work</Eyebrow>
        <h2 id="work-title" class="h1 mt-6 text-ink" data-split>
          What we have built,<br />
          <em class="accent-serif">labelled for what it is.</em>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal>
        <p class="text-ink-muted">
          Client work, our own products and design concepts are kept apart, so nothing here is
          passed off as something it is not.
        </p>
        <TextLink href="/work" class="mt-5">Every project, written up</TextLink>
      </div>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line lg:mt-20 lg:grid-cols-2">
      <!-- Client work -->
      <div class="bg-white p-7 sm:p-9" data-reveal>
        <p class="mono text-ink-faint">01 · Client work</p>
        {
          clients.length > 0 ? (
            <ul class="mt-5 space-y-4">
              {clients.map((p) => (
                <li>
                  <TextLink href={`/work/${p.slug}`}>{p.client}: {p.title}</TextLink>
                </li>
              ))}
            </ul>
          ) : (
            <>
              <p class="mt-5 max-w-md text-ink">
                Client case studies are being written up, and only with each client's permission to
                be named.
              </p>
              <p class="mt-3 max-w-md text-[0.9375rem] text-ink-muted">
                Until then, each service page shows exactly what a client receives.
              </p>
              <TextLink href="/services/web" class="mt-5">
                What a website project delivers
              </TextLink>
            </>
          )
        }
      </div>

      <!-- Our products: a pointer, not a repeat of the band above. -->
      <div class="bg-white p-7 sm:p-9" data-reveal data-reveal-delay="0.06">
        <p class="mono text-ink-faint">02 · Our products</p>
        <ul class="mt-5 space-y-5">
          {
            products.map((p) => (
              <li>
                <p class="text-ink">
                  <span class="font-medium">{p.title}</span>
                  <span class="text-ink-muted"> — {p.summary}</span>
                </p>
                <div class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
                  <TextLink href={`/work/${p.slug}`}>How we built {p.title}</TextLink>
                  <TextLink href="/products">{p.title} product details</TextLink>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      concepts.length > 0 && (
        <div class="mt-16 lg:mt-20">
          <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
            <p class="mono text-ink-faint">03 · Design concepts</p>
            <p class="max-w-md text-[0.9375rem] text-ink-muted">
              Our own design exercises. Not client work, and they claim no results.
            </p>
          </div>

          <ul class="mt-8 grid gap-6 md:grid-cols-3">
            {concepts.map((p, i) => {
              const service = byService.get(p.service)!;
              return (
                <li class="flex" data-reveal data-reveal-delay={(i % 3) * 0.06}>
                  <article class="concept card-paper relative flex w-full flex-col overflow-hidden">
                    <div class="relative p-2.5">
                      {p.image && (
                        <Image
                          src={p.image.wide}
                          alt=""
                          widths={[400, 640, 900]}
                          sizes="(min-width: 768px) 30vw, 90vw"
                          loading="lazy"
                          class="aspect-[3/2] w-full rounded-[var(--radius-sm)] object-cover"
                        />
                      )}
                      <span class="concept-badge mono absolute left-5 top-5 rounded-full px-2.5 py-1.5">
                        Concept
                      </span>
                    </div>
                    <div class="flex flex-1 flex-col px-6 pb-6 pt-4">
                      <p class="mono text-ink-faint">{service.title}</p>
                      <h3 class="mt-3 text-[1.375rem] font-medium tracking-[-0.015em] text-ink">
                        <a href={`/work/${p.slug}`} class="after:absolute after:inset-0 after:z-[1]">
                          {p.title}
                          <span class="sr-only"> (design concept)</span>
                        </a>
                      </h3>
                      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">{p.summary}</p>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Sits on a photograph, so it carries its own solid ground rather than
     relying on whatever the image happens to be under it. */
  .concept-badge {
    background: rgb(11 53 88 / 0.86);
    color: #ffffff;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
</style>
