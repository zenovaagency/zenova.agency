---
import Eyebrow from '../ui/Eyebrow.astro';
import TextLink from '../ui/TextLink.astro';
import ServiceCard from '../ServiceCard.astro';
import { SERVICES } from '../../data/site';

/**
 * The four services as a bento: two long cells and two tall ones, mirrored
 * between the rows so the grid zig-zags instead of stacking identical boxes.
 *
 *   row 1   Web (wide, 7)        App (tall, 5)
 *   row 2   AI (tall, 5)         Marketing (wide, 7)
 *
 * One column below lg, in the same order.
 */
const layout = [
  { slug: 'web', span: 'lg:col-span-7', kind: 'wide' },
  { slug: 'app', span: 'lg:col-span-5', kind: 'tall' },
  { slug: 'ai', span: 'lg:col-span-5', kind: 'tall' },
  { slug: 'marketing', span: 'lg:col-span-7', kind: 'wide' },
] as const;
const bySlug = new Map(SERVICES.map((s) => [s.slug, s]));
---

<section id="services" class="section-y relative" aria-labelledby="services-title">
  <div class="container-z">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow>What we build</Eyebrow>
        <h2 id="services-title" class="h1 mt-6 text-ink" data-split>
          Four services,<br /><em class="accent-serif">one team behind all of them.</em>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal>
        <p class="text-ink-muted">
          Scoped with you on a call, then a fixed price per phase. Whatever we build is yours from
          day one: code, designs, domain and accounts.
        </p>
        <TextLink href="/services" class="mt-5">Compare all four services</TextLink>
      </div>
    </div>

    <ul class="mt-14 grid gap-6 lg:mt-20 lg:grid-cols-12">
      {
        layout.map((cell, i) => (
          <li class:list={['flex', cell.span]} data-reveal data-reveal-delay={(i % 2) * 0.08}>
            <ServiceCard service={bySlug.get(cell.slug)!} layout={cell.kind} class="w-full" />
          </li>
        ))
      }
    </ul>
  </div>
</section>
