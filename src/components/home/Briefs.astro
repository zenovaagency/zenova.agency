---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import TextLink from '../ui/TextLink.astro';
import { DELIVERABLES, PRICING, SERVICES } from '../../data/site';

/**
 * One project brief per service: what it costs, how long it takes and what
 * lands in the client's hands. It is the document a creative studio starts
 * every job from, used here as the frame for the commercial detail a business
 * owner wants before they book a call.
 *
 * Nothing on this page is written for it. Prices and timelines are PRICING,
 * which site.ts marks as the real published rate cards, and the deliverables
 * are DELIVERABLES. All four briefs render at once: a price hidden behind a
 * tab is a price nobody compares, and every plan stays in the HTML.
 *
 * It makes no promise the data does not: there is no standalone pricing page
 * to link to (each service page carries the full scope and prices), and the
 * old "fixed quote" assurances went with the pricing copy they lived in.
 */
const briefs = SERVICES.map((service) => ({
  service,
  plans: PRICING.find((p) => p.slug === service.slug)?.plans ?? [],
  deliverables: DELIVERABLES.filter((d) => d.service === service.slug),
}));
---

<section id="briefs" class="section-y relative bg-white" aria-labelledby="briefs-title">
  <div class="container-z">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow>Briefs and rates</Eyebrow>
        <h2 id="briefs-title" class="h1 mt-6 text-ink" data-split>
          What it costs,<br /><em class="accent-serif">how long it takes.</em>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal>
        <p class="text-ink-muted">
          The real starting prices and timelines for each service, and what you
          walk away with.
        </p>
        <div class="mt-6">
          <Button href="/contact">Book a scoping call</Button>
        </div>
      </div>
    </div>

    <ul class="mt-14 grid gap-6 lg:mt-20 lg:grid-cols-2 lg:gap-8">
      {
        briefs.map(({ service: s, plans, deliverables }, i) => (
          <li class="flex" data-reveal data-reveal-delay={(i % 2) * 0.08}>
            <article
              class="card-tint flex w-full flex-col p-7 sm:p-9"
              aria-labelledby={`brief-${s.slug}`}
            >
              <div class="flex items-center justify-between gap-4">
                <div class="mono flex items-center gap-3 text-ink-faint">
                  <span class="tabular-nums">{s.n}</span>
                  <span class="h-px w-8 bg-line-strong" />
                  <span>Brief</span>
                </div>
                <span class="brief-stamp mono">Starting rates</span>
              </div>

              <h3
                id={`brief-${s.slug}`}
                class="mt-6 text-[1.75rem] font-medium leading-[1.1] tracking-[-0.02em] text-ink sm:text-[2rem]"
              >
                {s.title}
              </h3>
              <p class="mt-3 max-w-md text-[0.9375rem] leading-relaxed text-ink-muted">
                {s.hero}
              </p>

              <p class="mono mt-9 text-ink">One-time price and timeline</p>
              <ul class="mt-3 divide-y divide-line border-y border-line">
                {plans.map((plan) => (
                  <li class="py-3.5">
                    <div class="flex items-baseline gap-3">
                      <span class="font-medium text-ink">{plan.name}</span>
                      <span
                        class="mb-[5px] min-w-3 flex-1 border-b border-dotted border-line-strong"
                        aria-hidden="true"
                      />
                      <span class="shrink-0 whitespace-nowrap text-[1.375rem] font-medium leading-none tracking-[-0.02em] text-ink tabular-nums">
                        {plan.price}
                      </span>
                    </div>
                    <!-- The badge rides the timeline line, not the price line:
                         beside a long name and a price like "from $24k" it has
                         no room on a phone and forces both to wrap. -->
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2">
                      <p class="mono text-ink-faint">{plan.timeline}</p>
                      {plan.highlighted && (
                        <span class="mono rounded-full bg-[#eef4ff] px-2.5 py-1.5 text-brand-text">
                          Most popular
                        </span>
                      )}
                    </div>
                  </li>
                ))}
              </ul>

              <p class="mono mt-9 text-ink">You receive</p>
              <ul class="mt-4 space-y-4">
                {deliverables.map((d) => (
                  <li class="flex items-center gap-4">
                    {d.image && (
                      <Image
                        src={d.image.src}
                        width={160}
                        height={120}
                        alt=""
                        loading="lazy"
                        class="h-[60px] w-20 shrink-0 rounded-sm border border-line object-cover"
                      />
                    )}
                    <div>
                      <p class="text-[0.9375rem] font-medium text-ink">{d.title}</p>
                      <p class="mt-0.5 text-[0.875rem] leading-snug text-ink-muted">{d.blurb}</p>
                    </div>
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-9">
                <TextLink href={`/services/${s.slug}`}>Scope and pricing</TextLink>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  /* The ink stamp on each sheet. Brand-text rather than brand: it is real
     text, and --color-brand is decorative only (see global.css). The outline
     gives the double rule of a rubber stamp without a second element. */
  .brief-stamp {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 7px 10px;
    border: 1.5px solid var(--color-brand-text);
    border-radius: 6px;
    outline: 1px solid var(--color-brand-text);
    outline-offset: 2px;
    color: var(--color-brand-text);
    transform: rotate(-5deg);
  }
</style>
