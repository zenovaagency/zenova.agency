---
import Eyebrow from '../ui/Eyebrow.astro';
import { PROCESS } from '../../data/site';

/**
 * The four delivery phases. A horizontal track on desktop, a vertical
 * timeline on phones: the same ordered list, restyled, so the reading order
 * never changes between the two.
 */
---

<section id="process" class="section-y relative border-y border-line bg-white" aria-labelledby="process-title">
  <div class="container-z">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow>{PROCESS.eyebrow}</Eyebrow>
        <h2 id="process-title" class="h1 mt-6 text-ink" data-split>
          {PROCESS.title}<br /><em class="accent-serif">{PROCESS.titleAccent}</em>
        </h2>
      </div>
      <p class="text-ink-muted lg:col-span-4 lg:col-start-9" data-reveal>{PROCESS.sub}</p>
    </div>

    <ol class="track mt-14 grid gap-0 lg:mt-20 lg:grid-cols-4 lg:gap-6">
      {
        PROCESS.steps.map((s, i) => (
          <li class="step relative pb-10 pl-10 lg:pb-0 lg:pl-0 lg:pt-10" data-reveal data-reveal-delay={i * 0.06}>
            <span class="step-node" aria-hidden="true" />
            <p class="mono flex items-center gap-3 text-ink-faint">
              <span class="tabular-nums">{s.n}</span>
              <span>{s.timeline}</span>
            </p>
            <h3 class="mt-4 text-[1.5rem] font-medium leading-tight tracking-[-0.015em] text-ink">
              {s.title}
            </h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted">{s.blurb}</p>
            <p class="mono mt-5 text-ink-faint">You receive</p>
            <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-ink">
              {s.deliverables.map((d) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-[9px] h-1 w-2.5 shrink-0 rounded-full bg-sky" aria-hidden="true" />
                  {d}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 text-[0.875rem] text-ink-faint lg:mt-14" data-reveal>{PROCESS.note}</p>
  </div>
</section>

<style>
  /* The rail. Vertical on phones, horizontal from lg. */
  .step::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 0;
    width: 1px;
    background: var(--color-line-strong);
  }
  .step:last-child::before {
    display: none;
  }
  .step-node {
    position: absolute;
    left: 0;
    top: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid var(--color-brand);
    background: radial-gradient(circle, var(--color-brand) 0 3px, #ffffff 3.5px);
  }

  @media (min-width: 1024px) {
    .step::before {
      left: 22px;
      right: -24px;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
</style>
