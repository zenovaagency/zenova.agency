---
import { TESTIMONIALS, TESTIMONIALS_COPY, photoUrl } from '../../data/testimonials';

/**
 * Testimonials: a centred headline over one row of portrait cards that drifts
 * in a seamless loop. Each photo fades into the card's white so the quote can
 * sit over its lower edge.
 *
 * Content lives in data/testimonials.ts, whose header explains why today's
 * entries are labelled samples and how to swap in real ones. The label and the
 * disclosure line here are driven by that flag, so they leave on their own
 * once every entry is real.
 *
 * Motion. The row pauses on hover and focus, off screen, and from its own
 * pause button (WCAG 2.2.2). Under reduced motion it becomes a static grid.
 */
const hasSamples = TESTIMONIALS.some((t) => t.sample);

// Two copies: the track slides by exactly one, and twelve cards are already
// wider than a 1920px screen, so the far edge never runs dry.
const COPIES = 2;

// Rotate the monogram gradient so neighbouring fallbacks never read as one
// repeated asset.
const ANGLES = ['135deg', '200deg', '160deg', '225deg', '110deg', '180deg'];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

{
  TESTIMONIALS.length > 0 && (
    <section id="testimonials" class="section-y relative overflow-hidden" aria-labelledby="testimonials-title">
      <div class="container-z text-center">
        <h2 id="testimonials-title" class="h1 text-ink" data-split>
          {TESTIMONIALS_COPY.titleLead} <em class="accent-serif">{TESTIMONIALS_COPY.accent}</em>
          <br />
          {TESTIMONIALS_COPY.titleTail}
        </h2>
        <p class="mt-5 text-ink-muted" data-reveal>
          {TESTIMONIALS_COPY.sub}
        </p>
        {hasSamples && (
          <p class="mx-auto mt-3 max-w-[40rem] text-[0.8125rem] leading-relaxed text-ink-faint" data-reveal>
            {TESTIMONIALS_COPY.sampleNote}
          </p>
        )}
      </div>

      <div class="rail mt-14 lg:mt-16" data-rail>
        <div class="rail-view">
          <ul class="rail-track flex w-max" style={`--dur:${TESTIMONIALS.length * 7}s`}>
            {Array.from({ length: COPIES }, (_, copy) =>
              TESTIMONIALS.map((t, i) => (
                <li
                  class:list={['flex pr-5', copy > 0 && 'rail-dup']}
                  aria-hidden={copy > 0 ? 'true' : undefined}
                >
                  <figure class="card-paper t-card flex w-[17.5rem] flex-col overflow-hidden sm:w-[19rem]">
                    <div
                      class="avatar-ground relative flex aspect-[4/3.6] items-center justify-center overflow-hidden"
                      style={`--angle:${ANGLES[i % ANGLES.length]}`}
                    >
                      <span class="text-[3rem] font-medium tracking-[-0.02em]" aria-hidden="true">
                        {initials(t.name)}
                      </span>
                      {t.photo && (
                        <img
                          src={photoUrl(t.photo.src, 480, 432)}
                          srcset={`${photoUrl(t.photo.src, 480, 432)} 480w, ${photoUrl(t.photo.src, 800, 720)} 800w`}
                          sizes="304px"
                          alt={t.photo.alt ?? ''}
                          width="480"
                          height="432"
                          loading="lazy"
                          decoding="async"
                          onerror="this.remove()"
                          class="absolute inset-0 h-full w-full object-cover"
                        />
                      )}
                      <span class="t-fade absolute inset-0" aria-hidden="true" />
                      {t.sample && (
                        <span class="sample-tag mono absolute right-3 top-3">Sample</span>
                      )}
                    </div>

                    <div class="relative -mt-14 flex flex-1 flex-col px-5 pb-5">
                      <svg class="h-[18px] w-[22px] text-ink" viewBox="0 0 22 18" fill="currentColor" aria-hidden="true">
                        <path d="M0 0h8.5v9.5L5 18H1.5l2.6-8.5H0V0Zm12.5 0H21v9.5L17.5 18H14l2.6-8.5h-4.1V0Z" />
                      </svg>
                      <blockquote class="mt-3 text-[0.9375rem] font-medium leading-snug text-ink">
                        <p>{t.quote}</p>
                      </blockquote>
                      <figcaption class="mt-auto pt-5 text-right text-[0.8125rem] text-ink-muted">
                        — {t.name}, {t.company}
                      </figcaption>
                    </div>
                  </figure>
                </li>
              )),
            )}
          </ul>
        </div>

        <div class="container-z mt-5 flex justify-end">
          <button
            type="button"
            class="rail-toggle mono inline-flex items-center gap-2 rounded-[var(--radius-btn)] px-3 py-2 text-ink-soft hover:text-ink"
            aria-pressed="false"
            data-rail-toggle
          >
            <svg class="icon-pause h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
              <rect x="2" y="1" width="3" height="10" rx="0.5" />
              <rect x="7" y="1" width="3" height="10" rx="0.5" />
            </svg>
            <svg class="icon-play h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
              <path d="M3 1.5v9a.5.5 0 0 0 .77.42l7-4.5a.5.5 0 0 0 0-.84l-7-4.5A.5.5 0 0 0 3 1.5Z" />
            </svg>
            <span data-rail-label>Pause quotes</span>
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const toggle = rail?.querySelector<HTMLButtonElement>('[data-rail-toggle]');
  const label = toggle?.querySelector('[data-rail-label]');

  if (rail && toggle && label) {
    toggle.addEventListener('click', () => {
      const paused = rail.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play quotes' : 'Pause quotes';
    });
    // Off screen, the row has nothing to animate for.
    new IntersectionObserver(([e]) => rail.classList.toggle('is-offscreen', !e.isIntersecting)).observe(rail);
  }
</script>

<style>
  /* Brand-text rather than brand: this is real text. A white pill keeps it
     legible over any photo. */
  .sample-tag {
    padding: 4px 8px;
    border: 1px solid var(--color-brand-text);
    border-radius: 6px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-brand-text);
  }

  /* Monogram behind the portrait, shown only if the photo fails. */
  .avatar-ground {
    color: var(--color-ink);
    background: linear-gradient(
      var(--angle),
      rgb(191 224 255 / 0.9) 0%,
      rgb(244 248 255 / 1) 55%,
      rgb(255 224 236 / 0.9) 100%
    );
  }

  /* The photo melts into the card, so the quote can start over its edge. */
  .t-fade {
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0) 45%,
      rgb(255 255 255 / 0.85) 80%,
      var(--color-surface) 100%
    );
  }

  /* --- Rail ------------------------------------------------------------- *
   * The track holds the row twice; sliding by exactly one copy loops
   * seamlessly. Spacing is padding on each item rather than flex gap, so one
   * copy is exactly half the track.
   * ---------------------------------------------------------------------- */
  .rail-view {
    overflow: hidden;
    padding-block: 10px 16px; /* room for the card hover lift and shadow */
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .rail-track {
    animation: rail-slide var(--dur) linear infinite;
  }

  .rail:hover .rail-track,
  .rail:focus-within .rail-track,
  .rail.is-paused .rail-track,
  .rail.is-offscreen .rail-track {
    animation-play-state: paused;
  }

  @keyframes rail-slide {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .rail-toggle .icon-play,
  .rail.is-paused .rail-toggle .icon-pause {
    display: none;
  }

  .rail.is-paused .rail-toggle .icon-play {
    display: block;
  }

  /* Reduced motion: no drift, no copies, just a centred grid of cards. */
  @media (prefers-reduced-motion: reduce) {
    .rail-view {
      mask-image: none;
    }

    .rail-track {
      animation: none;
      width: auto;
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--gutter);
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 20px;
    }

    .rail-dup,
    .rail-toggle {
      display: none;
    }
  }
</style>
