---
import Eyebrow from '../ui/Eyebrow.astro';
import TestimonialAvatar from './TestimonialAvatar.astro';
import { SERVICES } from '../../data/site';
import { TESTIMONIALS, TESTIMONIALS_COPY, photoUrl } from '../../data/testimonials';

/**
 * Testimonials, in two parts:
 *
 *   Spotlight  the `featured` entries, one at a time on a full-bleed card,
 *              with a tab row underneath that auto-advances.
 *   Wall       everything else, as two rows drifting in opposite directions.
 *
 * Content lives in data/testimonials.ts, whose header explains why today's
 * entries are labelled samples and how to swap in real ones. The label and the
 * disclosure line here are driven by that flag, so they leave on their own
 * once every entry is real.
 *
 * Motion. Both parts pause on hover and focus, and the wall has its own pause
 * button (WCAG 2.2.2). Clicking a tab stops the spotlight for good. Under
 * reduced motion the spotlight never auto-advances and the wall becomes a
 * static grid.
 */
const serviceTitle = new Map(SERVICES.map((s) => [s.slug, s.title]));
const hasSamples = TESTIMONIALS.some((t) => t.sample);

const featured = TESTIMONIALS.filter((t) => t.featured);
const wall = TESTIMONIALS.filter((t) => !t.featured);
const half = Math.ceil(wall.length / 2);
const rows = [wall.slice(0, half), wall.slice(half)].filter((r) => r.length > 0);

// Three copies per row: the track slides by one copy, and three keep the far
// edge filled on a 1920px screen.
const COPIES = 3;

// Rotate the monogram gradient so neighbouring fallbacks never read as one
// repeated asset.
const ANGLES = ['135deg', '200deg', '160deg', '225deg', '110deg', '180deg'];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

{
  TESTIMONIALS.length > 0 && (
    <section id="testimonials" class="section-y relative overflow-hidden" aria-labelledby="testimonials-title">
      <div class="container-z">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <Eyebrow>{TESTIMONIALS_COPY.eyebrow}</Eyebrow>
            <h2 id="testimonials-title" class="h1 mt-6 text-ink" data-split>
              {TESTIMONIALS_COPY.title}
              <br />
              <em class="accent-serif">{TESTIMONIALS_COPY.accent}</em>
            </h2>
          </div>
          {hasSamples && (
            <p class="text-ink-muted lg:col-span-4 lg:col-start-9" data-reveal>
              {TESTIMONIALS_COPY.sampleNote}
            </p>
          )}
        </div>

        {featured.length > 0 && (
          <div class="spot mt-14 lg:mt-20" data-spotlight data-reveal>
            <div class="spot-stage card-bleed card-live" style="--angle:150deg;--i:2">
              <span class="card-glow" aria-hidden="true" />
              {featured.map((t, i) => (
                <figure
                  id={`spot-${t.id}`}
                  role="tabpanel"
                  aria-labelledby={`spot-tab-${t.id}`}
                  class:list={[
                    'spot-panel grid gap-7 p-6 sm:p-10 lg:grid-cols-12 lg:gap-12 lg:p-12',
                    i === 0 && 'is-active',
                  ]}
                  data-panel
                >
                  <div class="lg:col-span-4">
                    <div
                      class="spot-photo avatar-ground relative flex aspect-[4/5] w-28 items-center justify-center overflow-hidden rounded-[var(--radius-md)] sm:w-36 lg:w-full"
                      style={`--angle:${ANGLES[i % ANGLES.length]}`}
                      aria-hidden="true"
                    >
                      <span class="text-[2rem] font-medium tracking-[-0.02em] lg:text-[4rem]">
                        {initials(t.name)}
                      </span>
                      {t.photo && (
                        <img
                          src={photoUrl(t.photo.src, 480, 600)}
                          srcset={`${photoUrl(t.photo.src, 480, 600)} 480w, ${photoUrl(t.photo.src, 800, 1000)} 800w`}
                          sizes="(min-width: 1024px) 380px, 144px"
                          alt=""
                          width="480"
                          height="600"
                          loading="lazy"
                          decoding="async"
                          onerror="this.remove()"
                          class="absolute inset-0 h-full w-full object-cover"
                        />
                      )}
                    </div>
                  </div>

                  <div class="flex flex-col lg:col-span-8">
                    <div class="flex items-center justify-between gap-3">
                      <span class="mono text-white">
                        {serviceTitle.get(t.service)} · {t.location}
                      </span>
                      {t.sample && <span class="sample-tag sample-tag-light mono">Sample</span>}
                    </div>

                    <blockquote class="spot-quote mb-8 mt-6 lg:mt-8">
                      <p class="accent-serif text-[1.625rem] leading-[1.18] sm:text-[2.125rem] lg:text-[2.625rem]">
                        “{t.quote}”
                      </p>
                    </blockquote>

                    <figcaption class="mt-auto flex flex-wrap items-end justify-between gap-x-10 gap-y-6 border-t border-white/20 pt-6">
                      <div>
                        <p class="text-[1.125rem] font-medium">{t.name}</p>
                        <p class="text-[0.9375rem] text-white">
                          {t.role}, {t.company}
                        </p>
                      </div>
                      {t.result && (
                        <div class="sm:text-right">
                          <p class="text-[2rem] font-medium leading-none tracking-[-0.02em] tabular-nums sm:text-[2.5rem]">
                            {t.result.value}
                          </p>
                          <p class="mt-2 text-[0.875rem] text-white">{t.result.label}</p>
                        </div>
                      )}
                    </figcaption>
                  </div>
                </figure>
              ))}
            </div>

            {featured.length > 1 && (
              <div
                role="tablist"
                aria-label="Featured testimonials"
                class="spot-tabs mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4"
              >
                {featured.map((t, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`spot-tab-${t.id}`}
                    aria-controls={`spot-${t.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    class="spot-tab relative flex items-center gap-3 overflow-hidden rounded-[var(--radius-md)] border border-line bg-white px-3 py-3 text-left sm:px-4"
                    data-tab
                  >
                    <span class="spot-progress" aria-hidden="true" data-progress />
                    <TestimonialAvatar t={t} size={40} angle={ANGLES[i % ANGLES.length]} />
                    <span class="min-w-0">
                      <span class="block truncate text-[0.9375rem] font-medium text-ink">{t.name}</span>
                      <span class="block truncate text-[0.8125rem] text-ink-muted">{t.company}</span>
                    </span>
                  </button>
                ))}
              </div>
            )}
          </div>
        )}
      </div>

      {rows.length > 0 && (
        <div class="wall mt-6 lg:mt-8" data-wall>
          {rows.map((row, r) => (
            <div class="wall-row" style={`--dur:${row.length * 16 + r * 8}s`} data-reverse={r % 2 === 1 ? '' : undefined}>
              <ul class="wall-track flex w-max">
                {Array.from({ length: COPIES }, (_, copy) =>
                  row.map((t, i) => (
                    <li
                      class:list={['flex pr-5', copy > 0 && 'wall-dup']}
                      aria-hidden={copy > 0 ? 'true' : undefined}
                    >
                      <figure class="card-paper flex w-[19rem] flex-col p-6 sm:w-[23rem] sm:p-7">
                        <div class="flex items-center justify-between gap-3">
                          <span class="mono text-ink-faint">{serviceTitle.get(t.service)}</span>
                          {t.sample && <span class="sample-tag mono">Sample</span>}
                        </div>

                        <blockquote class="mb-6 mt-5 text-[1rem] leading-relaxed text-ink">
                          <p>{t.quote}</p>
                        </blockquote>

                        {t.result && (
                          <p class="-mt-1 mb-6 flex items-baseline gap-2.5">
                            <span class="text-[1.375rem] font-medium tracking-[-0.02em] text-brand-text tabular-nums">
                              {t.result.value}
                            </span>
                            <span class="text-[0.8125rem] leading-snug text-ink-muted">{t.result.label}</span>
                          </p>
                        )}

                        <figcaption class="mt-auto flex items-center gap-3.5 border-t border-line pt-5">
                          <TestimonialAvatar
                            t={t}
                            size={44}
                            angle={ANGLES[(i + r * 3) % ANGLES.length]}
                          />
                          <div class="min-w-0">
                            <p class="font-medium leading-snug text-ink">{t.name}</p>
                            <p class="text-[0.8125rem] leading-snug text-ink-muted">
                              {t.role}, {t.company} · {t.location}
                            </p>
                          </div>
                        </figcaption>
                      </figure>
                    </li>
                  )),
                )}
              </ul>
            </div>
          ))}

          <div class="container-z mt-5 flex justify-end">
            <button
              type="button"
              class="wall-toggle mono inline-flex items-center gap-2 rounded-[var(--radius-btn)] px-3 py-2 text-ink-soft hover:text-ink"
              aria-pressed="false"
              data-wall-toggle
            >
              <svg class="icon-pause h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <rect x="2" y="1" width="3" height="10" rx="0.5" />
                <rect x="7" y="1" width="3" height="10" rx="0.5" />
              </svg>
              <svg class="icon-play h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M3 1.5v9a.5.5 0 0 0 .77.42l7-4.5a.5.5 0 0 0 0-.84l-7-4.5A.5.5 0 0 0 3 1.5Z" />
              </svg>
              <span data-wall-label>Pause quotes</span>
            </button>
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  import { reducedMotion } from '../../lib/motion';

  // --- Spotlight: an ARIA tablist that auto-advances ----------------------
  const spot = document.querySelector<HTMLElement>('[data-spotlight]');
  const tabs = spot ? [...spot.querySelectorAll<HTMLButtonElement>('[data-tab]')] : [];
  const panels = spot ? [...spot.querySelectorAll<HTMLElement>('[data-panel]')] : [];

  if (spot && tabs.length > 1) {
    const select = (index: number, focus = false) => {
      const next = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i]?.classList.toggle('is-active', on);
      });
      if (focus) tabs[next].focus();
    };

    const current = () => tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    // A reader who picks a quote gets to keep it.
    const stop = () => spot.classList.remove('is-playing');

    const KEYS: Record<string, (i: number) => number> = {
      ArrowRight: (i) => i + 1,
      ArrowDown: (i) => i + 1,
      ArrowLeft: (i) => i - 1,
      ArrowUp: (i) => i - 1,
      Home: () => 0,
      End: () => tabs.length - 1,
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        stop();
        select(i);
      });
      tab.addEventListener('keydown', (e) => {
        const to = KEYS[e.key];
        if (!to) return;
        e.preventDefault();
        stop();
        select(to(i), true);
      });
      // The progress bar is the timer: when its fill finishes, move on.
      tab.querySelector('[data-progress]')?.addEventListener('animationend', () => {
        if (spot.classList.contains('is-playing')) select(current() + 1);
      });
    });

    // Never auto-advance under reduced motion: the global rule shortens every
    // animation to 0.01ms, which would make the timer fire continuously.
    if (!reducedMotion()) {
      spot.classList.add('is-playing');
      const hold = (on: boolean) => spot.classList.toggle('is-held', on);
      spot.addEventListener('pointerenter', () => hold(true));
      spot.addEventListener('pointerleave', () => hold(spot.contains(document.activeElement)));
      spot.addEventListener('focusin', () => hold(true));
      spot.addEventListener('focusout', (e) => hold(spot.contains(e.relatedTarget as Node)));
      new IntersectionObserver(([e]) => spot.classList.toggle('is-offscreen', !e.isIntersecting)).observe(spot);
    }
  }

  // --- Wall: pause button -------------------------------------------------
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const toggle = wall?.querySelector<HTMLButtonElement>('[data-wall-toggle]');
  const label = toggle?.querySelector('[data-wall-label]');

  if (wall && toggle && label) {
    toggle.addEventListener('click', () => {
      const paused = wall.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play quotes' : 'Pause quotes';
    });
    // Off screen, the rows have nothing to animate for.
    new IntersectionObserver(([e]) => wall.classList.toggle('is-offscreen', !e.isIntersecting)).observe(wall);
  }
</script>

<style>
  /* Brand-text rather than brand: this is real text. Same stamp language as
     the demo label on /work, without the rotation. */
  .sample-tag {
    flex-shrink: 0;
    padding: 4px 8px;
    border: 1px solid var(--color-brand-text);
    border-radius: 6px;
    color: var(--color-brand-text);
  }

  .sample-tag-light {
    border-color: rgb(255 255 255 / 0.6);
    color: #ffffff;
  }

  /* Monogram behind the spotlight portrait, shown only if the photo fails. */
  .avatar-ground {
    color: var(--color-ink);
    background: linear-gradient(
      var(--angle),
      rgb(191 224 255 / 0.9) 0%,
      rgb(244 248 255 / 1) 55%,
      rgb(255 224 236 / 0.9) 100%
    );
  }

  .spot-photo {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18), 0 18px 40px rgb(0 20 60 / 0.35);
  }

  /* --- Spotlight -------------------------------------------------------- *
   * With JS, every panel shares one grid cell, so the card is always as tall
   * as the longest quote and switching never shifts the page. Without JS the
   * panels simply stack and the tabs, which could not work, are hidden.
   * ---------------------------------------------------------------------- */
  :global(html.js) .spot-stage {
    display: grid;
  }

  :global(html.js) .spot-panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 450ms var(--ease-out-expo),
      visibility 0s linear 450ms;
  }

  :global(html.js) .spot-panel.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 450ms var(--ease-out-expo),
      visibility 0s;
  }

  :global(html:not(.js)) .spot-panel + .spot-panel {
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  :global(html:not(.js)) .spot-tabs {
    display: none;
  }

  /* The incoming quote rises and the portrait settles, a beat apart. */
  .spot-panel .spot-quote,
  .spot-panel .spot-photo img {
    transition: transform 700ms var(--ease-out-expo);
  }

  :global(html.js) .spot-panel:not(.is-active) .spot-quote {
    transform: translateY(14px);
  }

  :global(html.js) .spot-panel:not(.is-active) .spot-photo img {
    transform: scale(1.06);
  }

  .spot-tab {
    transition:
      border-color 180ms var(--ease-out-expo),
      box-shadow 180ms var(--ease-out-expo),
      background-color 180ms var(--ease-out-expo);
  }

  .spot-tab:hover {
    border-color: var(--color-sky-soft);
  }

  .spot-tab[aria-selected='true'] {
    border-color: var(--color-sky);
    box-shadow: var(--shadow-md);
  }

  .spot-tab[aria-selected='false'] :global(.avatar) {
    filter: grayscale(0.6);
    opacity: 0.8;
  }

  .spot-progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-brand), var(--color-sky), var(--color-blush));
    transform: scaleX(0);
    transform-origin: left;
  }

  .spot-tab[aria-selected='true'] .spot-progress {
    transform: scaleX(1);
  }

  /* The fill doubles as the timer; see the animationend handler. */
  .spot.is-playing .spot-tab[aria-selected='true'] .spot-progress {
    animation: spot-progress 8s linear forwards;
  }

  .spot.is-held .spot-progress,
  .spot.is-offscreen .spot-progress {
    animation-play-state: paused !important;
  }

  @keyframes spot-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* --- Wall ------------------------------------------------------------- *
   * Each track holds its row three times; sliding by exactly one copy loops
   * seamlessly. Spacing is padding on each item rather than flex gap, so one
   * copy is exactly a third of the track.
   * ---------------------------------------------------------------------- */
  .wall-row {
    overflow: hidden;
    padding-block: 10px 14px; /* room for the card hover lift and shadow */
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .wall-row + .wall-row {
    margin-top: 6px;
  }

  .wall-track {
    animation: wall-slide var(--dur) linear infinite;
  }

  .wall-row[data-reverse] .wall-track {
    animation-direction: reverse;
  }

  .wall:hover .wall-track,
  .wall:focus-within .wall-track,
  .wall.is-paused .wall-track,
  .wall.is-offscreen .wall-track {
    animation-play-state: paused;
  }

  @keyframes wall-slide {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-100% / 3), 0, 0);
    }
  }

  .wall-toggle .icon-play,
  .wall.is-paused .wall-toggle .icon-pause {
    display: none;
  }

  .wall.is-paused .wall-toggle .icon-play {
    display: block;
  }

  /* Reduced motion: no drift, no copies, just a centred grid of cards. */
  @media (prefers-reduced-motion: reduce) {
    .wall-row {
      mask-image: none;
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .wall-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 20px;
    }

    .wall-dup,
    .wall-toggle {
      display: none;
    }
  }
</style>
