---
import { SERVICES } from '../../data/site';
// Deliberately offset column starts: a centred four-across row of stats is
// the single most template-looking block on any agency site.
const spans = [
  'lg:col-span-5 lg:col-start-1',
  'lg:col-span-4 lg:col-start-8',
  'lg:col-span-4 lg:col-start-2',
  'lg:col-span-5 lg:col-start-8',
];
---

<section class="section-y relative">
  <div class="container-z">
    <div class="grid gap-x-8 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <h2 class="h2 max-w-lg text-ink" data-split>
          Numbers we have <em class="accent-serif">actually moved</em>.
        </h2>
        <p class="mt-5 max-w-sm text-ink-muted" data-reveal>
          Averages across the work, not a best case. Every project ends with one
          number we agreed to move.
        </p>
      </div>

      {
        SERVICES.map((s, i) => (
          <div class:list={['flex items-start gap-6', spans[i]]} data-reveal>
            <span class="mono mt-4 shrink-0 text-ink-faint tabular-nums">{s.n}</span>
            <div>
              <span
                class="grad-text block text-[clamp(3.75rem,9vw,6.5rem)] font-medium leading-[0.94] tracking-[-0.04em] tabular-nums"
                data-count
              >
                {s.stat.value}
              </span>
              <p class="mt-3 text-[1.0625rem] text-ink">{s.stat.label}</p>
              <p class="mono mt-1.5 text-ink-faint">{s.title}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
