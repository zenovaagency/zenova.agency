---
import Logo from './Logo.astro';
import { SITE, SERVICES } from '../../data/site';
import { PRODUCTS } from '../../data/products';

const year = new Date().getFullYear();

// Secondary destinations live here rather than in the header: Blog and
// Careers matter, but they are not where a buyer starts.
const company = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/contact' },
];

const link = 'text-ink-muted transition-colors hover:text-ink';
---

<footer class="relative overflow-hidden border-t border-line bg-white">
  <div class="container-z pb-10 pt-[var(--section-y)]">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-3">
        <Logo size={26} />
        <p class="mt-5 max-w-xs text-ink-muted">{SITE.tagline}</p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-6 inline-block text-lg text-brand-text underline decoration-sky decoration-1 underline-offset-4 transition-colors hover:decoration-brand"
        >
          {SITE.email}
        </a>
      </div>

      <nav class="lg:col-span-3" aria-label="Services">
        <p class="mono mb-5 text-ink-faint">Services</p>
        <ul class="space-y-3">
          {
            SERVICES.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class={link}>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Products">
        <p class="mono mb-5 text-ink-faint">Products</p>
        <ul class="space-y-3">
          {
            PRODUCTS.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener" class={`${link} inline-flex items-center gap-1.5`}>
                  {p.name}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7 17 17 7m0 0H9m8 0v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            ))
          }
          <li>
            <a href="/products" class={link}>All products</a>
          </li>
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Company">
        <p class="mono mb-5 text-ink-faint">Company</p>
        <ul class="space-y-3">
          {
            company.map((n) => (
              <li>
                <a href={n.href} class={link}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Social">
        <p class="mono mb-5 text-ink-faint">Elsewhere</p>
        <ul class="space-y-3">
          {
            SITE.socials.map((s) => (
              <li>
                <a href={s.url} rel="me noopener noreferrer" target="_blank" class={link}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="mono text-ink-faint">{SITE.copyright.replace('2026', String(year))}</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <nav aria-label="Legal" class="mono flex items-center gap-5">
          <a href="/terms" class={link}>Terms</a>
          <a href="/privacy" class={link}>Privacy</a>
        </nav>
        <p class="mono text-ink-faint">{SITE.strapline}</p>
      </div>
    </div>
  </div>

  <!-- Oversized wordmark, cropped by the footer edge. Decorative only, and
       the accessible name already exists in the lockup above.

       Two layers of the same word: the brand gradient, and a glow layer on
       top that lights the letters near the cursor. The script splits both
       into letters, raises them out of the footer edge when the footer
       comes into view, and gives each letter its slice of the one gradient
       so the word still reads as a single fill. Without JS, or under
       reduced motion, this is the plain gradient word. -->
  <div class="wm pointer-events-none select-none px-[var(--gutter)]" aria-hidden="true" data-wordmark>
    <div class="wm__inner relative translate-y-[22%]">
      <span class="wm__word grad-text" data-wm-layer>Zenova</span>
      <span class="wm__word wm__glow" data-wm-layer>Zenova</span>
    </div>
  </div>
</footer>

<style>
  .wm__word {
    position: relative;
    display: block;
    text-align: center;
    font-weight: 500;
    font-size: clamp(5rem, 20vw, 17rem);
    line-height: 0.78;
    letter-spacing: -0.045em;
  }

  /* The glow layer only exists once the script has split it. */
  .wm__glow {
    position: absolute;
    inset: 0;
    display: none;
    opacity: 0;
    transition: opacity 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .wm[data-wm-split] .wm__glow {
    display: block;
  }
  .wm[data-wm-glow] .wm__glow {
    opacity: 1;
  }

  /* Split: the layer gives up its own fill, and each letter takes its slice
     of a gradient sized to the whole word (--w), offset by where the letter
     sits in it (--x). */
  .wm[data-wm-split] .wm__word {
    background: none;
  }
  .wm :global(.wm__ch) {
    display: inline-block;
    background-size: var(--w, 100%) 100%;
    background-position: calc(var(--x, 0px) * -1) 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .wm .grad-text :global(.wm__ch) {
    background-image: linear-gradient(
      100deg,
      var(--color-brand-text) 0%,
      var(--color-brand) 38%,
      var(--color-sky) 74%,
      var(--color-blush) 100%
    );
    transform: translateY(118%);
    transition: transform 1100ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--i) * 70ms);
  }
  .wm[data-wm-in] .grad-text :global(.wm__ch) {
    transform: none;
  }
  /* --gx / --gy are in the word's own coordinates, like the gradient. */
  .wm__glow :global(.wm__ch) {
    background-image: radial-gradient(
      15rem circle at var(--gx, -50rem) var(--gy, 50%),
      #0b3558 0%,
      var(--color-brand-text) 34%,
      rgb(255 174 203 / 0.9) 56%,
      transparent 74%
    );
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-wordmark]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduced) {
    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-wm-layer]'));
    const text = (layers[0]?.textContent ?? '').trim();
    let origin = 0;

    layers.forEach((layer) => {
      layer.textContent = '';
      [...text].forEach((ch, i) => {
        const span = document.createElement('span');
        span.className = 'wm__ch';
        span.textContent = ch;
        span.style.setProperty('--i', String(i));
        layer.append(span);
      });
    });
    root.dataset.wmSplit = '';

    // Each letter's slice of the word-wide gradient. offsetLeft ignores
    // transforms, so this is right mid-rise too.
    const measure = () => {
      layers.forEach((layer) => {
        const chars = Array.from(layer.children) as HTMLElement[];
        if (!chars.length) return;
        const first = chars[0];
        const last = chars[chars.length - 1];
        origin = first.offsetLeft;
        const width = last.offsetLeft + last.offsetWidth - origin;
        chars.forEach((c) => {
          c.style.setProperty('--w', `${width}px`);
          c.style.setProperty('--x', `${c.offsetLeft - origin}px`);
        });
      });
    };
    measure();
    document.fonts?.ready.then(measure);
    new ResizeObserver(measure).observe(root);

    // Rise once, when the wordmark is properly in view.
    const total = text.length * 70 + 1100;
    let risen = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        root.dataset.wmIn = '';
        io.disconnect();
        setTimeout(() => (risen = true), total);
      },
      { threshold: 0.35 },
    );
    io.observe(root);

    // The glow follows the pointer anywhere over the footer. Fine pointers
    // only: on touch there is nothing to follow.
    const footer = root.closest('footer');
    if (footer && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const glow = layers[1];
      let frame = 0;
      footer.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = glow.getBoundingClientRect();
          root.style.setProperty('--gx', `${e.clientX - r.left - origin}px`);
          root.style.setProperty('--gy', `${e.clientY - r.top}px`);
          if (risen) root.dataset.wmGlow = '';
        });
      });
      footer.addEventListener('pointerleave', () => delete root.dataset.wmGlow);
    }
  }
</script>
