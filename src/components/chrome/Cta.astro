---
import Button from '../ui/Button.astro';
import { CTA } from '../../data/site';
---

<section class="pb-[var(--section-y)] pt-6">
  <div class="container-z">
    <!--
      .card-live adds the ambient light drift and .card-glow-violet the purple
      pass; the recipes, and the contrast arithmetic behind both, are in
      styles/cards.css. --stop-a/--stop-b shift this card's ramp to
      indigo -> violet-blue -> brand blue, and --i (Services uses 0-3)
      desyncs the drift from those cards.
    -->
    <div
      class="card-bleed card-live relative overflow-hidden px-7 py-16 text-center sm:px-12 sm:py-24"
      style="--angle: 118deg; --i: 4; --stop-a: #1e1a5e; --stop-b: #4338ca"
      data-reveal
    >
      <span class="card-glow" aria-hidden="true" />
      <span class="card-glow-violet" aria-hidden="true" />

      <p class="mono text-white">{CTA.eyebrow}</p>

      <h2
        class="mx-auto mt-6 max-w-3xl text-[clamp(2.5rem,7vw,4.75rem)] font-medium leading-[1.05] tracking-[-0.03em]"
      >
        {CTA.title}<br /><em class="accent-serif">{CTA.accent}</em>
      </h2>

      <p class="mx-auto mt-6 max-w-md text-[1.0625rem] text-white">{CTA.sub}</p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href={CTA.primaryHref} variant="light">{CTA.primary}</Button>
        <a
          href={CTA.secondaryHref}
          class="rounded-[10px] border border-white/50 px-6 py-[14px] text-[0.9375rem] font-medium leading-none text-white transition-[transform,background-color,color] duration-[180ms] ease-[var(--ease-out-expo)] hover:-translate-y-0.5 hover:bg-white hover:text-brand-text"
        >
          {CTA.secondary}
        </a>
      </div>
    </div>
  </div>
</section>
