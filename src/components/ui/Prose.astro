---
/**
 * Long-form body typography, shared by the blog post template and the legal
 * pages. Extracted from [slug].astro once a second consumer existed — the
 * rules are identical because both surfaces are the same thing: quiet prose
 * on paper, read start to finish.
 *
 * Hand-rolled scoped CSS rather than the typography plugin: the site's type
 * system (weights never above 500, ink-scale text, underlined brand-text
 * links) is already specified in tokens, and the plugin would import a second
 * set of defaults to fight.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['prose-post', className]}>
  <slot />
</div>

<style>
  /*
    In the house voice: no weight above 500 (the site never uses 700), the
    ink scale for body and secondary text, brand-text for links (the AA-safe
    blue — --color-brand fails contrast as text), Instrument Serif reserved
    for page titles' accent slot, not the body.
  */
  .prose-post {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .prose-post :global(p) {
    margin-top: 1.35em;
  }

  .prose-post :global(h2) {
    margin-top: 2.4em;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .prose-post :global(h3) {
    margin-top: 2em;
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
  }

  /* Every h2/h3 followed by a heading-started section would carry the
     previous block's bottom margin as dead air; margin-collapse handles the
     common case, but a heading right after a list needs this. */
  .prose-post :global(h2 + p),
  .prose-post :global(h3 + p) {
    margin-top: 0.75em;
  }

  .prose-post :global(a) {
    color: var(--color-brand-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s var(--ease-out-expo, ease-out);
  }

  .prose-post :global(a:hover) {
    color: var(--color-ink);
  }

  .prose-post :global(strong) {
    font-weight: 500;
    color: var(--color-ink);
  }

  .prose-post :global(ul),
  .prose-post :global(ol) {
    margin-top: 1.35em;
    padding-left: 1.4em;
  }

  .prose-post :global(ul) {
    list-style: disc;
  }

  .prose-post :global(ol) {
    list-style: decimal;
  }

  .prose-post :global(li + li) {
    margin-top: 0.45em;
  }

  .prose-post :global(li::marker) {
    color: var(--color-ink-faint);
  }

  .prose-post :global(blockquote) {
    margin-top: 2em;
    padding-left: 1.25em;
    border-left: 2px solid var(--color-brand);
    color: var(--color-ink);
  }

  .prose-post :global(blockquote p:first-of-type) {
    margin-top: 0;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .prose-post :global(code) {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--color-ink-faint);
    color: var(--color-ink);
  }

  .prose-post :global(pre) {
    margin-top: 1.75em;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md, 14px);
    border: 1px solid var(--color-line, #e4e7eb);
    overflow-x: auto;
  }

  .prose-post :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose-post :global(hr) {
    margin-top: 2.5em;
    border: 0;
    border-top: 1px solid var(--color-line, #e4e7eb);
  }

  /* Inline images get the card treatment and the alt text is the caption
     surface: the alt attribute is for assistive tech, so the visible styling
     stays decoration-only. */
  .prose-post :global(img) {
    margin-top: 2em;
    width: 100%;
    border-radius: var(--radius-md, 14px);
    border: 1px solid var(--color-line, #e4e7eb);
  }
</style>
