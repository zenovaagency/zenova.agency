---
/**
 * Buttons use --color-brand-text (#0060E6), never --color-brand (#006BFF).
 * White on #006BFF is ~4.45:1 and fails AA at 16px. This is an audited
 * constraint carried over from the previous site.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'light';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-2 rounded-[10px] px-6 py-[15px] text-[0.9375rem] font-medium leading-none transition-[transform,background-color,border-color,box-shadow] duration-[180ms] ease-[var(--ease-out-expo)] hover:-translate-y-0.5 active:translate-y-0';

const variants = {
  primary:
    'bg-brand-text text-white shadow-[0_2px_4px_rgb(11_53_88/0.10),0_10px_24px_rgb(0_96_230/0.22)] hover:bg-[#0a52c4] hover:shadow-[0_4px_8px_rgb(11_53_88/0.12),0_16px_36px_rgb(0_96_230/0.28)]',
  ghost:
    'border border-line-strong bg-white/70 text-ink backdrop-blur-sm hover:border-sky hover:bg-white',
  light:
    'bg-white text-brand-text shadow-[0_8px_24px_rgb(11_53_88/0.16)] hover:bg-white',
};
---

<a href={href} class:list={[base, variants[variant], className]}>
  <span><slot /></span>
  <svg
    width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"
    class="transition-transform duration-[180ms] ease-[var(--ease-out-expo)] group-hover:translate-x-[3px]"
  >
    <path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>
