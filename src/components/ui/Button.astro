---
/**
 * The one button. Styles live in styles/buttons.css so the React islands can
 * use the same classes.
 *
 * A link when it has an `href` (navigation), a <button> when it does not
 * (actions). Never a <button> wrapped in a link or the other way round.
 *
 * Primary fills use --color-brand-text (#0060E6), never --color-brand
 * (#006BFF): white on #006BFF is ~4.45:1 and fails AA at 16px. This is an
 * audited constraint carried over from the previous site.
 *
 * `ghost` and `light` are the previous variant names, kept as aliases so an
 * old call site cannot silently render unstyled.
 *
 * Buttons never move: no drift toward the cursor and no hover lift. Only
 * colour, border and the arrow inside its chip change.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'on-dark' | 'on-dark-secondary' | 'ghost' | 'light';
  size?: 'sm' | 'md' | 'lg';
  /** Defaults to an inline arrow on links and none on buttons. */
  arrow?: 'inline' | 'split' | 'none';
  /** Off-site link: opens in a new tab and says so to screen readers. */
  external?: boolean;
  loading?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  arrow,
  external = false,
  loading = false,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const aliases: Record<string, string> = { ghost: 'secondary', light: 'on-dark' };
const tone = aliases[variant] ?? variant;
const arrowMode = arrow ?? (href ? 'inline' : 'none');

const classes = [
  'btn',
  `btn--${tone}`,
  size !== 'md' && `btn--${size}`,
  arrowMode === 'split' && 'btn--split',
  className,
];

const isLink = href !== undefined;
// A disabled link loses its href, so it drops out of the tab order and
// cannot be followed; aria-disabled tells assistive tech why.
const anchorAttrs = {
  href: disabled ? undefined : href,
  'aria-disabled': disabled ? ('true' as const) : undefined,
  target: external ? '_blank' : undefined,
  rel: external ? 'noopener' : undefined,
};
const buttonAttrs = { type, disabled: disabled || undefined };
const shared = {
  'data-loading': loading ? '' : undefined,
  'aria-busy': loading ? ('true' as const) : undefined,
};

const straight = 'M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5';
const diagonal = 'M7 17 17 7m0 0H9m8 0v8';
const d = external ? diagonal : straight;
---

{
  isLink ? (
    <a class:list={classes} {...anchorAttrs} {...shared} {...rest}>
      <span class="btn__label">
        <slot />
        {external && <span class="sr-only"> (opens in a new tab)</span>}
        {arrowMode === 'inline' && (
          <span class:list={['btn__arrow', external && 'btn__arrow--external']} aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={d} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={d} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        )}
      </span>
      {arrowMode === 'split' && (
        <span class="btn__cell" aria-hidden="true">
          <span class:list={['btn__arrow', external && 'btn__arrow--external']}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={d} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={d} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </span>
      )}
      {loading && <span class="btn__spinner" aria-hidden="true" />}
    </a>
  ) : (
    <button class:list={classes} {...buttonAttrs} {...shared} {...rest}>
      <span class="btn__label">
        <slot />
        {arrowMode === 'inline' && (
          <span class="btn__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={straight} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={straight} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        )}
      </span>
      {arrowMode === 'split' && (
        <span class="btn__cell" aria-hidden="true">
          <span class="btn__arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={straight} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={straight} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </span>
      )}
      <span class="btn__spinner" aria-hidden="true" />
    </button>
  )
}
