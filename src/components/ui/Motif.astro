---
/**
 * Abstract line-art for service and project cards.
 *
 * These exist so the four services are told apart by their drawing rather
 * than by a stock icon dropped into a rounded square. Everything is drawn in
 * currentColor, so a motif inherits whatever surface it sits on.
 *
 * browser / phone / flow / chart belong to the four services. dashboard /
 * cart / inbox / editor are for projects, which need their own drawings: a
 * project card sits directly below the service hero panel on
 * /services/<slug>, and the same drawing twice on one screen reads as a
 * rendering bug rather than a house style.
 *
 * The union lives in data/site.ts so Service.motif and Project.motif cannot
 * drift from what this file can actually draw.
 */
import type { MotifKind } from '../../data/site';

interface Props {
  kind: MotifKind;
  class?: string;
}
const { kind, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 320 210"
  fill="none"
  aria-hidden="true"
  class:list={['w-full', className]}
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    kind === 'browser' && (
      <g>
        <rect x="18" y="16" width="284" height="178" rx="12" opacity=".85" />
        <path d="M18 46h284" opacity=".55" />
        <circle cx="38" cy="31" r="3.5" opacity=".7" />
        <circle cx="52" cy="31" r="3.5" opacity=".5" />
        <circle cx="66" cy="31" r="3.5" opacity=".35" />
        <rect x="92" y="25" width="120" height="12" rx="6" opacity=".3" />
        <rect x="38" y="66" width="120" height="9" rx="4.5" fill="currentColor" opacity=".55" stroke="none" />
        <rect x="38" y="84" width="86" height="9" rx="4.5" fill="currentColor" opacity=".3" stroke="none" />
        <rect x="38" y="112" width="108" height="62" rx="8" opacity=".45" />
        <rect x="160" y="112" width="60" height="62" rx="8" opacity=".3" />
        <rect x="234" y="112" width="48" height="62" rx="8" opacity=".22" />
        <rect x="196" y="62" width="86" height="30" rx="8" fill="currentColor" opacity=".22" stroke="none" />
      </g>
    )
  }

  {
    kind === 'phone' && (
