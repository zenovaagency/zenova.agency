        <rect x="124" y="92" width="52" height="7" rx="3.5" fill="currentColor" opacity=".5" stroke="none" />
        <rect x="124" y="106" width="72" height="7" rx="3.5" fill="currentColor" opacity=".28" stroke="none" />
        <rect x="124" y="126" width="34" height="34" rx="8" opacity=".45" />
        <rect x="162" y="126" width="34" height="34" rx="8" opacity=".3" />
        <path d="M136 182h48" opacity=".5" />
        <rect x="40" y="46" width="52" height="112" rx="12" opacity=".28" />
        <rect x="228" y="46" width="52" height="112" rx="12" opacity=".28" />
      </g>
    )
  }

  {
    kind === 'flow' && (
      <g>
        <rect x="16" y="86" width="74" height="38" rx="10" opacity=".8" />
