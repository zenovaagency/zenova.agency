        <rect x="42" y="130" width="132" height="44" rx="8" opacity=".4" />
        <circle cx="66" cy="146" r="6" fill="currentColor" opacity=".35" stroke="none" />
        <path d="M50 168l30-22 22 14 24-18 22 26" opacity=".45" />
        <rect x="208" y="54" width="94" height="104" rx="10" opacity=".75" />
        <rect x="222" y="74" width="48" height="7" rx="3.5" fill="currentColor" opacity=".45" stroke="none" />
