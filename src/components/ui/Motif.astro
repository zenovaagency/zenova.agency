        <rect x="222" y="106" width="40" height="7" rx="3.5" fill="currentColor" opacity=".28" stroke="none" />
        <rect x="222" y="124" width="56" height="12" rx="6" fill="currentColor" opacity=".22" stroke="none" />
      </g>
    )
  }
</svg>
