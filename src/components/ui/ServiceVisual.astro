        <rect x="372" y="92" width="42" height="12" rx="6" fill={C.brand} />
        <rect class="a v-grow" style="--d:0" x="242" y="124" width="150" height="14" rx="7" fill={C.ink} />
        <rect x="242" y="146" width="112" height="14" rx="7" fill={C.ink} />
        <rect x="242" y="172" width="168" height="6" rx="3" fill={C.muted} />
        <rect x="242" y="184" width="140" height="6" rx="3" fill={C.muted} />
        <rect x="242" y="206" width="172" height="86" rx="10" fill={`url(#${id}-brand)`} fill-opacity="0.85" />
        <path d="M242 276 C280 246 320 286 360 258 S404 252 414 262 V282 Q414 292 404 292 H252 Q242 292 242 282Z" fill="#fff" fill-opacity="0.3" />
      </g>
    )
  }

  {
    key === 'app-a' && (
      <g>
        <defs>
          <clipPath id={`${id}-screen`}>
            <rect x="160" y="34" width="160" height="292" rx="24" />
          </clipPath>
        </defs>
        <g filter={`url(#${id}-shadow)`}>
          <rect x="150" y="22" width="180" height="316" rx="32" fill={C.ink} />
        </g>
        <rect x="160" y="34" width="160" height="292" rx="24" fill="#fff" />
        <g clip-path={`url(#${id}-screen)`}>
          <rect x="214" y="40" width="52" height="12" rx="6" fill={C.ink} />
          <rect x="176" y="68" width="60" height="7" rx="3.5" fill={C.muted} />
          <rect x="176" y="80" width="104" height="13" rx="6.5" fill={C.ink} />
          <g class="a v-scroll">
            <rect x="176" y="106" width="128" height="72" rx="14" fill={`url(#${id}-brand)`} />
            <rect x="188" y="120" width="54" height="7" rx="3.5" fill="#fff" fill-opacity="0.9" />
            <rect x="188" y="134" width="84" height="12" rx="6" fill="#fff" />
            <rect x="188" y="156" width="36" height="12" rx="6" fill="#fff" fill-opacity="0.35" />
            {[192, 240, 288, 336].map((y, i) => (
              <g>
                <rect x="176" y={y} width="128" height="40" rx="10" fill={C.tint} />
                <circle cx="194" cy={y + 20} r="9" fill={C.brand} fill-opacity={0.3 + (i % 2) * 0.4} />
                <rect x="210" y={y + 12} width={60 - i * 6} height="6" rx="3" fill={C.ink} fill-opacity="0.8" />
                <rect x="210" y={y + 24} width="44" height="5" rx="2.5" fill={C.muted} />
              </g>
            ))}
          </g>
          <rect x="160" y="290" width="160" height="36" fill="#fff" />
          <line x1="160" y1="290" x2="320" y2="290" stroke={C.line} />
          {[186, 222, 258, 294].map((x) => (
            <rect x={x - 7} y="301" width="14" height="10" rx="3" fill={C.muted} />
          ))}
          <circle class="a v-tab" cx="186" cy="318" r="2.5" fill={C.brand} />
        </g>

        <g class="a v-float" style="--d:-1">
          <g filter={`url(#${id}-shadow)`}>
            <rect x="292" y="74" width="160" height="54" rx="14" fill="#fff" stroke={C.line} />
          </g>
          <rect x="304" y="86" width="30" height="30" rx="9" fill={C.brand} />
          <path d="M313 101 l4 4 l8 -9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="344" y="92" width="80" height="7" rx="3.5" fill={C.ink} />
          <rect x="344" y="105" width="58" height="5" rx="2.5" fill={C.muted} />
        </g>
        <g class="a v-float" style="--d:-3.5">
          <g filter={`url(#${id}-shadow)`}>
            <rect x="34" y="228" width="140" height="44" rx="22" fill="#fff" stroke={C.line} />
          </g>
          <circle cx="58" cy="250" r="11" fill={C.tint} />
          <path d="M53 250 l3.5 3.5 l6 -7" fill="none" stroke={C.brand} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <text x="76" y="254" font-size="12" fill={C.ink}>Release ready</text>
        </g>
      </g>
    )
  }

  {
    key === 'app-b' && (
      <g>
        <path d="M118 196 C160 196 160 180 196 180" fill="none" stroke={C.muted} stroke-width="2" />
        <path d="M296 166 C330 166 330 96 356 96" fill="none" stroke={C.muted} stroke-width="2" />
        <path d="M296 194 C330 194 330 262 356 262" fill="none" stroke={C.muted} stroke-width="2" />
        <path class="a v-flow" pathLength="1" d="M118 196 C160 196 160 180 196 180" fill="none" stroke={C.brand} stroke-width="4" stroke-linecap="round" />
        <path class="a v-flow" style="--d:0.9" pathLength="1" d="M296 166 C330 166 330 96 356 96" fill="none" stroke={C.brand} stroke-width="4" stroke-linecap="round" />
        <path class="a v-flow" style="--d:1.6" pathLength="1" d="M296 194 C330 194 330 262 356 262" fill="none" stroke={C.brand} stroke-width="4" stroke-linecap="round" />

        <g filter={`url(#${id}-shadow)`}>
          <rect x="40" y="128" width="78" height="136" rx="18" fill={C.ink} />
        </g>
        <rect x="47" y="138" width="64" height="116" rx="12" fill="#fff" />
        <rect x="55" y="150" width="36" height="6" rx="3" fill={C.ink} />
        <rect x="55" y="164" width="48" height="26" rx="6" fill={`url(#${id}-brand)`} />
        <rect x="55" y="198" width="48" height="8" rx="4" fill={C.tint} />
        <rect x="55" y="212" width="48" height="8" rx="4" fill={C.tint} />
        <text x="79" y="290" font-size="12" fill={C.ink} text-anchor="middle">App</text>

        <g filter={`url(#${id}-shadow)`}>
          <rect x="196" y="140" width="100" height="80" rx="20" fill={`url(#${id}-brand)`} />
        </g>
        <text x="246" y="176" font-size="18" fill="#fff" text-anchor="middle">API</text>
        <text x="246" y="196" font-size="10" fill="#fff" fill-opacity="0.85" text-anchor="middle">REST · webhooks</text>

        <g filter={`url(#${id}-shadow)`}>
          <rect x="356" y="64" width="96" height="64" rx="14" fill="#fff" stroke={C.line} />
        </g>
        <rect x="370" y="80" width="22" height="18" rx="4" fill="none" stroke={C.brand} stroke-width="2" />
        <path d="M374 80 v-4 a7 7 0 0 1 14 0 v4" fill="none" stroke={C.brand} stroke-width="2" />
        <text x="400" y="94" font-size="12" fill={C.ink}>Auth</text>
        <rect x="370" y="108" width="68" height="5" rx="2.5" fill={C.muted} />

        <g filter={`url(#${id}-shadow)`}>
          <rect x="356" y="228" width="96" height="68" rx="14" fill="#fff" stroke={C.line} />
        </g>
        <ellipse cx="381" cy="246" rx="11" ry="4" fill="none" stroke={C.brand} stroke-width="2" />
        <path d="M370 246 v16 a11 4 0 0 0 22 0 v-16 M370 254 a11 4 0 0 0 22 0" fill="none" stroke={C.brand} stroke-width="2" />
        <text x="400" y="258" font-size="12" fill={C.ink}>Data</text>
        <rect x="370" y="276" width="68" height="5" rx="2.5" fill={C.muted} />

        <g class="a v-pop" style="--d:0.2">
          <circle cx="296" cy="140" r="11" fill="#fff" stroke={C.brand} stroke-width="1.5" />
          <path d="M291 140 l3.5 3.5 l6 -7" fill="none" stroke={C.brand} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
    )
  }

  {
    key === 'ai-a' && (
      <g>
        <g filter={`url(#${id}-shadow)`}>
          <rect x="56" y="28" width="368" height="304" rx="18" fill="#fff" stroke={C.line} />
        </g>
        <circle cx="86" cy="58" r="13" fill={`url(#${id}-brand)`} />
        <path d="M86 50 l2.2 5.8 l5.8 2.2 l-5.8 2.2 l-2.2 5.8 l-2.2 -5.8 l-5.8 -2.2 l5.8 -2.2z" fill="#fff" />
        <text x="108" y="62" font-size="13" fill={C.ink}>Assistant</text>
        <circle cx="176" cy="58" r="3.5" fill={C.brand} />
        <line x1="56" y1="84" x2="424" y2="84" stroke={C.line} />

        <rect x="228" y="100" width="172" height="40" rx="16" fill={C.brand} />
        <rect x="244" y="112" width="128" height="6" rx="3" fill="#fff" />
        <rect x="244" y="124" width="84" height="6" rx="3" fill="#fff" fill-opacity="0.7" />

        <g class="a v-in" style="--d:0">
          <rect x="80" y="154" width="236" height="66" rx="16" fill={C.tint} />
          <rect x="96" y="168" width="196" height="6" rx="3" fill={C.ink} fill-opacity="0.8" />
          <rect x="96" y="181" width="176" height="6" rx="3" fill={C.ink} fill-opacity="0.8" />
          <rect x="96" y="194" width="120" height="6" rx="3" fill={C.ink} fill-opacity="0.8" />
