        </g>

        <rect x="80" y="262" width="58" height="24" rx="12" fill={C.tint} />
        <circle class="a v-dot" style="--d:0" cx="96" cy="274" r="3" fill={C.ink} />
        <circle class="a v-dot" style="--d:0.15" cx="109" cy="274" r="3" fill={C.ink} />
        <circle class="a v-dot" style="--d:0.3" cx="122" cy="274" r="3" fill={C.ink} />

        <rect x="80" y="296" width="320" height="26" rx="13" fill="#fff" stroke={C.line} />
        <rect x="96" y="306" width="120" height="6" rx="3" fill={C.muted} />
        <circle cx="386" cy="309" r="10" fill={C.brand} />
        <path d="M381 309 h9 m-3.5 -3.5 l3.5 3.5 l-3.5 3.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }

  {
    key === 'ai-b' && (
      <g>
        {[
          'M146 180 C170 180 172 180 192 180',
          'M292 166 C318 166 316 82 344 82',
          'M292 180 C316 180 320 180 344 180',
          'M292 194 C318 194 316 278 344 278',
        ].map((d) => (
          <path d={d} fill="none" stroke={C.muted} stroke-width="2" />
        ))}
        {[
          'M146 180 C170 180 172 180 192 180',
          'M292 166 C318 166 316 82 344 82',
          'M292 180 C316 180 320 180 344 180',
          'M292 194 C318 194 316 278 344 278',
        ].map((d, i) => (
          <path class="a v-flow" style={`--d:${i === 0 ? 0 : 0.7 + i * 0.25}`} pathLength="1" d={d} fill="none" stroke={C.brand} stroke-width="4" stroke-linecap="round" />
        ))}

        <g filter={`url(#${id}-shadow)`}>
          <rect x="30" y="138" width="116" height="84" rx="16" fill="#fff" stroke={C.line} />
        </g>
        <rect x="44" y="152" width="26" height="20" rx="4" fill="none" stroke={C.brand} stroke-width="2" />
        <path d="M44 154 l13 9 l13 -9" fill="none" stroke={C.brand} stroke-width="2" stroke-linejoin="round" />
        <text x="44" y="194" font-size="12" fill={C.ink}>New enquiry</text>
        <rect x="44" y="204" width="70" height="5" rx="2.5" fill={C.muted} />

        <g filter={`url(#${id}-shadow)`}>
          <rect x="192" y="118" width="100" height="124" rx="26" fill={`url(#${id}-brand)`} />
