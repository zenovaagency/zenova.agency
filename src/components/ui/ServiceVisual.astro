        <g class="a v-in" style="--d:0.15">
          <rect x="80" y="228" width="138" height="24" rx="12" fill="#fff" stroke={C.brand} stroke-opacity="0.5" />
          <rect x="92" y="234" width="9" height="12" rx="2" fill="none" stroke={C.brand} stroke-width="1.5" />
