---
/**
 * Code-built illustrations of what each service delivers. They replace the
 * AI-rendered webps the site used to ship: SVG scales crisply at any size,
 * weighs a few KB, stays in the brand palette, and can move.
 *
 *   web       a  a page assembling itself, with a cursor clicking the CTA
 *             b  a CMS editor with live-editing text and a Publish action
 *   app       a  a phone app: scrolling feed, stepping tab bar, notification
 *             b  the backend behind it: app → API → auth and data
 *   ai        a  an assistant answering from the business's own docs
 *             b  an automation: trigger → AI → three actions
 *   marketing a  a campaign dashboard: tiles, line chart, bars
 *             b  a channel plan: SEO, ads and email lanes on a timeline
 *
 * Nothing here shows a figure. Dashboards are bars and shapes, never numbers,
 * so no visual can be read as a claimed result.
 *
 * Motion lives in styles/visuals.css and only runs while the visual is on
 * screen (lib/inview.ts). Pass `decorative` when nearby text already says
 * what the picture shows.
 */
import type { ServiceSlug } from '../../data/site';

interface Props {
  kind: ServiceSlug;
  variant?: 'a' | 'b';
  decorative?: boolean;
  /** 'slice' fills the box and crops the edges, like object-fit: cover. */
  fit?: 'meet' | 'slice';
  class?: string;
}

const { kind, variant = 'a', decorative = false, fit = 'meet', class: className = '' } = Astro.props;

const labels: Record<string, string> = {
  'web-a': 'Illustration: a website being assembled in a browser window.',
  'web-b': 'Illustration: a content editor updating a live page.',
  'app-a': 'Illustration: a mobile app on a phone screen.',
  'app-b': 'Illustration: an app connected to its API, authentication and database.',
  'ai-a': 'Illustration: an AI assistant answering a customer from the business’s own documents.',
  'ai-b': 'Illustration: an automation where a new enquiry triggers AI and three follow-up actions.',
  'marketing-a': 'Illustration: a marketing dashboard with charts.',
  'marketing-b': 'Illustration: a channel plan for SEO, ads and email over four weeks.',
};

const key = `${kind}-${variant}`;
// Gradient ids must be unique per instance: several visuals share a page.
const id = `v${Math.random().toString(36).slice(2, 8)}`;

const C = {
  ink: '#0b3558',
  brand: '#0060e6',
  sky: '#6fb6ff',
  skySoft: '#bfe0ff',
  tint: '#eef4ff',
  line: '#dbe5f3',
  muted: '#b8c7db',
  blush: '#ffaecb',
};
---

<svg
  class:list={['viz', className]}
  viewBox="0 0 480 360"
  preserveAspectRatio={`xMidYMid ${fit}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : labels[key]}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
  data-visual
>
  <defs>
    <linearGradient id={`${id}-bg`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="480" y2="360">
      <stop offset="0" stop-color="#f4f8ff" />
      <stop offset="1" stop-color="#e3eeff" />
    </linearGradient>
    <radialGradient id={`${id}-glowA`} gradientUnits="userSpaceOnUse" cx="420" cy="30" r="300">
      <stop offset="0" stop-color={C.sky} stop-opacity="0.45" />
      <stop offset="1" stop-color={C.sky} stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`${id}-glowB`} gradientUnits="userSpaceOnUse" cx="40" cy="345" r="240">
      <stop offset="0" stop-color={C.blush} stop-opacity="0.35" />
      <stop offset="1" stop-color={C.blush} stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${id}-brand`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={C.sky} />
      <stop offset="1" stop-color={C.brand} />
    </linearGradient>
    <linearGradient id={`${id}-area`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={C.brand} stop-opacity="0.22" />
      <stop offset="1" stop-color={C.brand} stop-opacity="0" />
    </linearGradient>
    <filter id={`${id}-shadow`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#0b3558" flood-opacity="0.12" />
    </filter>
  </defs>

  {/* Backgrounds run far past the viewBox: the root <svg> clips to its
      viewport, not its viewBox, so when a frame letterboxes the drawing
      ("meet" in a wider or taller box) the bands are filled, not blank. */}
  <rect x="-800" y="-600" width="2080" height="1560" fill={`url(#${id}-bg)`} />
  <rect x="-800" y="-600" width="2080" height="1560" fill={`url(#${id}-glowA)`} />
  <rect x="-800" y="-600" width="2080" height="1560" fill={`url(#${id}-glowB)`} />

  {
    key === 'web-a' && (
      <g>
        <g filter={`url(#${id}-shadow)`}>
          <rect x="40" y="36" width="400" height="290" rx="16" fill="#fff" stroke={C.line} />
        </g>
        <circle cx="60" cy="54" r="4" fill={C.muted} />
        <circle cx="73" cy="54" r="4" fill={C.muted} />
        <circle cx="86" cy="54" r="4" fill={C.muted} />
        <rect x="170" y="46" width="140" height="16" rx="8" fill={C.tint} />
        <line x1="40" y1="72" x2="440" y2="72" stroke={C.line} />

        <g class="a v-in" style="--d:0">
          <rect x="64" y="88" width="44" height="9" rx="4.5" fill={C.ink} />
          <rect x="290" y="90" width="26" height="5" rx="2.5" fill={C.muted} />
          <rect x="324" y="90" width="26" height="5" rx="2.5" fill={C.muted} />
          <rect x="358" y="90" width="26" height="5" rx="2.5" fill={C.muted} />
          <rect x="392" y="85" width="32" height="14" rx="7" fill={C.brand} />
        </g>
        <g class="a v-in" style="--d:0.12">
          <rect x="64" y="122" width="168" height="13" rx="6.5" fill={C.ink} />
          <rect x="64" y="142" width="124" height="13" rx="6.5" fill={C.ink} />
        </g>
        <g class="a v-in" style="--d:0.24">
          <rect x="64" y="168" width="160" height="6" rx="3" fill={C.muted} />
          <rect x="64" y="180" width="128" height="6" rx="3" fill={C.muted} />
        </g>
        <g class="a v-in" style="--d:0.36">
          <rect x="64" y="200" width="76" height="22" rx="11" fill={C.brand} />
          <rect x="148" y="200" width="60" height="22" rx="11" fill="#fff" stroke={C.ink} stroke-opacity="0.4" />
        </g>
        <g class="a v-in" style="--d:0.3">
          <rect x="252" y="114" width="172" height="112" rx="12" fill={`url(#${id}-brand)`} />
          <circle cx="388" cy="146" r="16" fill="#fff" fill-opacity="0.55" />
          <path d="M252 206 C290 170 320 214 360 184 S410 176 424 190 V214 Q424 226 412 226 H264 Q252 226 252 214Z" fill="#fff" fill-opacity="0.35" />
        </g>
        {[64, 188, 312].map((x, i) => (
          <g class="a v-in" style={`--d:${0.48 + i * 0.1}`}>
            <rect x={x} y="242" width="112" height="66" rx="10" fill={C.tint} stroke={C.line} />
            <rect x={x + 12} y="254" width="18" height="18" rx="5" fill={C.brand} fill-opacity={0.25 + i * 0.25} />
            <rect x={x + 12} y="282" width="70" height="6" rx="3" fill={C.ink} fill-opacity="0.75" />
            <rect x={x + 12} y="294" width="50" height="5" rx="2.5" fill={C.muted} />
          </g>
        ))}

        <g class="a v-cursor">
          <circle class="a v-click" cx="196" cy="282" r="14" fill="none" stroke={C.brand} stroke-width="2" />
          <path d="M194 280 l0 22 l6 -6 l5 11 l4 -2 l-5 -11 l8 0 z" fill={C.ink} stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
        </g>
      </g>
    )
  }

  {
    key === 'web-b' && (
      <g>
        <g filter={`url(#${id}-shadow)`}>
          <rect x="30" y="36" width="420" height="290" rx="16" fill="#fff" stroke={C.line} />
        </g>
        <rect x="30" y="36" width="176" height="290" rx="16" fill={C.tint} />
        <rect x="190" y="36" width="16" height="290" fill={C.tint} />
        <line x1="206" y1="36" x2="206" y2="326" stroke={C.line} />

        <text x="50" y="66" font-size="12" fill={C.ink}>Edit page</text>
        <text x="50" y="94" font-size="10" fill={C.ink} fill-opacity="0.6">Headline</text>
        <rect x="50" y="102" width="136" height="28" rx="7" fill="#fff" stroke={C.brand} stroke-width="1.5" />
        <rect class="a v-grow" style="--d:0" x="60" y="112" width="96" height="8" rx="4" fill={C.ink} />
